@page
@model FTLSV2.Pages.TeacherPageModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Faculty Portal - FTLS</title>
    <link rel="stylesheet" href="../CSS/TeacherPage.css">
</head>
<body>

    <div class="teacher-container">
        <aside class="sidebar">
            <h2>Teacher Portal</h2>
            <nav>
                <a href="#" class="active">My Schedule</a>
                <a href="#">Curriculum View</a>
                <a href="#">Account Settings</a>
                <a href="LoginPage.html" class="logout">Logout</a>
            </nav>
        </aside>

        <main class="main-content">
            <header>
                <h1>Welcome, Engr. Harley</h1>
                <button class="btn-secondary">Download PDF Schedule</button>
            </header>

            <div class="teacher-grid">
                <section class="card stats">
                    <h3>Load Status</h3>
                    <p>Total Units: <strong>12 Units</strong></p>
                    <p>Status: <span class="status-regular">Regular Load</span></p>
                </section>

                <section class="card full-width">
                    <h3>My Assigned Classes (1st Semester)</h3>
                    <table class="schedule-table">
                        <thead>
                            <tr>
                                <th>Subject</th>
                                <th>Section</th>
                                <th>Schedule</th>
                                <th>Room</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>B104 - Intro to Programming</td>
                                <td>BSCpE - 1A</td>
                                <td>Mon/Wed 09:00 - 10:30</td>
                                <td>Lab A</td>
                            </tr>
                        </tbody>
                    </table>
                </section>
            </div>
        </main>
    </div>

</body>
</html>
