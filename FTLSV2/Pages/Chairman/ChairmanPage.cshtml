@page "/Chairman/ChairmanPage"
@model FTLSV2.Pages.Chairman.ChairmanPageModel

@{
    Layout = "_ChairmanLayout";
    ViewData["Title"] = "Scheduler";

    var timeOptions = new List<(string Value, string Text)>();
    var baseTime = new DateTime(2020, 1, 1, 7, 0, 0); // Start at 7:00 AM
    for (int i = 0; i <= 30; i++) // Up to 10:00 PM (15 hours)
    {
        var time = baseTime.AddMinutes(i * 30);
        timeOptions.Add((time.ToString("HH:mm"), time.ToString("hh:mm tt")));
    }
}

@functions {
    public (string Days, string Time) SplitScheduleForDisplay(string? schedule)
    {
        if (string.IsNullOrWhiteSpace(schedule))
            return ("—", "");

        var text = schedule.Trim();

        var match = System.Text.RegularExpressions.Regex.Match(
            text,
            @"^(?<days>[A-Za-z,\s]+?)\s+(?<time>\d{1,2}:\d{2}\s*(?:AM|PM)\s*-\s*\d{1,2}:\d{2}\s*(?:AM|PM))$",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase
        );

        if (!match.Success)
            return (text, "");

        var days = System.Text.RegularExpressions.Regex.Replace(
            match.Groups["days"].Value.Trim(),
            @"[\s,]+",
            ""
        );

        var time = System.Text.RegularExpressions.Regex.Replace(
            match.Groups["time"].Value.Trim(),
            @"\s+",
            " "
        ).ToUpperInvariant();

        return (days, time);
    }
}

