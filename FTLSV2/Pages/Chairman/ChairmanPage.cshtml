                ⚠ <strong>Faculty Unit Status Alerts</strong>
            </h4>

            <ul style="margin: 0; padding-left: 20px; font-size: 13px;">
                @foreach (var alert in Model.FacultyAlerts)
                {
                    <li style="margin-bottom: 4px;">
                        <strong>@alert.FacultyName</strong> (A.Y. @alert.AcademicYear): @alert.Message
