    async function updateAvailableRoomsForFlexibleSchedule() {
        const roomDropdown =
            document.getElementById("SelectedRoomId");

        if (!roomDropdown) {
            return;
        }

        const selectedCheckboxes =
            Array.from(
                document.querySelectorAll(
                    "[data-schedule-day]:checked"
                )
            );

        if (selectedCheckboxes.length === 0) {
            resetNewAssignmentRooms(roomDropdown);
            return;
        }

        const slots = [];

        for (const checkbox of selectedCheckboxes) {
            const day = checkbox.dataset.scheduleDay;

            const startInput = document.querySelector(
                `[data-day-start="${day}"]`
            );

            const endInput = document.querySelector(
                `[data-day-end="${day}"]`
            );

            if (
                !startInput ||
                !endInput ||
                !startInput.value ||
                !endInput.value ||
                endInput.value <= startInput.value
            ) {
                resetNewAssignmentRooms(roomDropdown);
                return;
            }

            slots.push({
                day: day,
                start: startInput.value,
                end: endInput.value
            });
        }

        const previouslySelectedRoom =
            roomDropdown.value;

        roomDropdown.innerHTML =
            '<option value="">Checking room availability...</option>';

        try {
            const responses = await Promise.all(
                slots.map(function (slot) {
                    const url =
                        `?handler=AvailableRooms` +
                        `&days=${encodeURIComponent(slot.day)}` +
                        `&startTime=${encodeURIComponent(slot.start)}` +
                        `&endTime=${encodeURIComponent(slot.end)}`;

                    return fetch(url).then(function (response) {
                        if (!response.ok) {
                            throw new Error("Unable to load available rooms.");
                        }

                        return response.json();
                    });
                })
            );

            if (responses.length === 0) {
                resetNewAssignmentRooms(roomDropdown);
                return;
            }

            let availableRooms = responses[0];

            for (let i = 1; i < responses.length; i++) {
                const allowedIds =
                    new Set(
                        responses[i].map(function (room) {
                            return String(room.roomId);
                        })
                    );

                availableRooms =
                    availableRooms.filter(function (room) {
                        return allowedIds.has(
                            String(room.roomId)
                        );
                    });
            }

            roomDropdown.innerHTML = "";

            if (!availableRooms || availableRooms.length === 0) {
                roomDropdown.innerHTML =
                    '<option value="">-- No Rooms Available for All Selected Slots --</option>';

                return;
            }

            roomDropdown.innerHTML =
                '<option value="">-- Select an Available Room --</option>';

            availableRooms.forEach(function (room) {
                const option =
                    document.createElement("option");

                option.value = room.roomId;
                option.textContent = room.name;

                roomDropdown.appendChild(option);
            });

            const previousStillExists =
                Array.from(roomDropdown.options)
                    .some(function (option) {
                        return option.value === previouslySelectedRoom;
                    });

            if (previousStillExists) {
                roomDropdown.value =
                    previouslySelectedRoom;
            }
        }
        catch (error) {
            console.error(error);

            roomDropdown.innerHTML =
                '<option value="">-- Error loading available rooms --</option>';
        }
    }

    function resetNewAssignmentRooms(roomDropdown) {
        const rooms = [
            @if (Model.AllRooms != null)
            {
                @foreach (var room in Model.AllRooms)
                {
                    <text>
                    {
                        roomId: @room.RoomId,
                        name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(room.Name))
                    },
                    </text>
                }
            }
        ];

        const currentValue =
            roomDropdown.value;

        roomDropdown.innerHTML =
            '<option value="">-- Select a Room --</option>';

        rooms.forEach(function (room) {
            const option =
                document.createElement("option");

            option.value = room.roomId;
            option.textContent = room.name;

            roomDropdown.appendChild(option);
        });

        const currentStillExists =
            Array.from(roomDropdown.options)
                .some(function (option) {
                    return option.value === currentValue;
                });

        if (currentStillExists) {
            roomDropdown.value = currentValue;
        }
    }


