            /* =========================================================
        EDIT SCHEDULE MODAL - ALIGNMENT POLISH
        Scoped only to Edit Assigned Schedule
        ========================================================= */

        #editScheduleModal .edit-form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }


        /* Keep all form controls perfectly aligned */
        #editScheduleModal .edit-form-group {
            min-width: 0;
        }

        #editScheduleModal .edit-input {
            width: 100%;
            height: 40px;
            box-sizing: border-box;
        }


        /* Schedule Days & Time section */
        #editScheduleModal .edit-form-group:has(.schedule-mode-toggle) {
            padding-top: 2px;
        }


        /* Make the two mode buttons equal width */
        #editScheduleModal .schedule-mode-toggle {
            display: grid;
            grid-template-columns: 1fr 1fr;

            width: 100%;
            box-sizing: border-box;

            gap: 5px;
            padding: 4px;
            margin-bottom: 14px;

            background: #f3f4f6;
            border: 1px solid #e5e7eb;
            border-radius: 9px;
        }

        #editScheduleModal .schedule-mode-option {
            width: 100%;
        }

        #editScheduleModal .schedule-mode-option span {
            width: 100%;
            box-sizing: border-box;

            padding: 8px 10px;

            text-align: center;
            white-space: nowrap;
        }


        /* Six equally sized day buttons */
        #editScheduleModal .schedule-day-picker {
            display: grid;
            grid-template-columns: repeat(6, 1fr);

            gap: 8px;
            width: 100%;
            margin-bottom: 14px;
        }

        #editScheduleModal .schedule-day-chip {
            width: 100%;
            min-width: 0;
            height: 40px;

            padding: 0;

            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;

            box-sizing: border-box;
        }


        /* Align the time panel with everything above */
        #editScheduleModal .schedule-mode-panel {
            width: 100%;
            box-sizing: border-box;

            padding: 12px;
            margin: 0;

            background: #f8fafc;
            border: 1px solid #d1d5db;
            border-radius: 8px;
        }

        #editScheduleModal .schedule-mode-panel-title {
            margin-bottom: 9px;
