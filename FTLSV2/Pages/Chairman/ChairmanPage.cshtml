<script>
    document.addEventListener("DOMContentLoaded", function () {
        @if (Model.ShowFacultyLoadPopup)
        {
            <text>
                openModal("facultyLoadModal");
            </text>
        }

        initializeFlexibleScheduleUi();
        initializeEditScheduleUi();
        initializeAlertAutoDismiss();
        initializeDynamicTimeDropdownFiltering();
    });

    function setupDynamicElementFiltering(startElement, endElement) {
        if (!startElement || !endElement) return;

        function updateEndTimeOptions() {
            const startTimeVal = startElement.value;
            if (!startTimeVal) return;

            const [startH, startM] = startTimeVal.split(":").map(Number);
            const startTotalMinutes = startH * 60 + startM;

            const currentEndTimeVal = endElement.value;
            let currentEndTimeValid = false;

            Array.from(endElement.options).forEach(option => {
                const optionVal = option.value;
                const [optH, optM] = optionVal.split(":").map(Number);
                const optTotalMinutes = optH * 60 + optM;

                if (optTotalMinutes <= startTotalMinutes) {
                    option.style.display = "none";
                    option.disabled = true;
                } else {
                    option.style.display = "";
                    option.disabled = false;
                    if (optionVal === currentEndTimeVal) {
                        currentEndTimeValid = true;
                    }
                }
            });

            if (!currentEndTimeValid) {
                const targetEndMinutes = startTotalMinutes + 90;
                const targetH = Math.floor(targetEndMinutes / 60);
                const targetM = targetEndMinutes % 60;
                const targetVal = `${String(targetH).padStart(2, '0')}:${String(targetM).padStart(2, '0')}`;

                let selected = false;
                for (let option of endElement.options) {
                    if (option.value === targetVal && !option.disabled) {
                        endElement.value = targetVal;
                        selected = true;
                        break;
                    }
                }
                if (!selected) {
                    for (let option of endElement.options) {
                        if (!option.disabled) {
                            endElement.value = option.value;
                            break;
                        }
                    }
                }
            }
        }

        updateEndTimeOptions();
        startElement.addEventListener("change", updateEndTimeOptions);
    }

    function initializeDynamicTimeDropdownFiltering() {
        setupDynamicElementFiltering(
            document.getElementById("commonStartTime"),
            document.getElementById("commonEndTime")
        );

        const days = ["M", "T", "W", "Th", "F", "S"];
        days.forEach(day => {
            const startSelect = document.querySelector(`select[data-day-start="${day}"]`);
            const endSelect = document.querySelector(`select[data-day-end="${day}"]`);
            setupDynamicElementFiltering(startSelect, endSelect);
        });

        setupDynamicElementFiltering(
            document.getElementById("editStartTime"),
            document.getElementById("editEndTime")
        );

        days.forEach(day => {
            const startSelect = document.querySelector(`select[data-edit-day-start="${day}"]`);
