            const start =
                document.getElementById("editStartTime")?.value;

            const end =
                document.getElementById("editEndTime")?.value;

            if (!start || !end || end <= start) {
                return;
            }

            selectedCheckboxes.forEach(function (checkbox) {
                slots.push({
                    day: checkbox.dataset.editDay,
                    start: start,
                    end: end
                });
            });
        }
        else {
            for (const checkbox of selectedCheckboxes) {
                const day =
                    checkbox.dataset.editDay;

                const startInput =
                    document.querySelector(
                        `[data-edit-day-start="${day}"]`
                    );

                const endInput =
                    document.querySelector(
                        `[data-edit-day-end="${day}"]`
                    );

                if (
                    !startInput ||
                    !endInput ||
                    !startInput.value ||
                    !endInput.value ||
                    endInput.value <= startInput.value
                ) {
                    return;
                }

                slots.push({
                    day: day,
                    start: startInput.value,
                    end: endInput.value
                });
            }
        }

        const requestedRoomId =
            currentRoomId !== null &&
            !(currentRoomId instanceof Event)
                ? String(currentRoomId)
                : roomDropdown.value;

        roomDropdown.innerHTML =
            '<option value="">Checking room availability...</option>';

        try {
            const responses =
                await Promise.all(
                    slots.map(function (slot) {
                        const url =
                            `?handler=AvailableRooms` +
                            `&days=${encodeURIComponent(slot.day)}` +
                            `&startTime=${encodeURIComponent(slot.start)}` +
                            `&endTime=${encodeURIComponent(slot.end)}` +
                            `&excludeScheduleId=${encodeURIComponent(scheduleId)}`;

                        return fetch(url)
                            .then(function (response) {
                                if (!response.ok) {
                                    throw new Error(
                                        "Unable to load available rooms."
                                    );
                                }

                                return response.json();
                            });
                    })
                );

            if (responses.length === 0) {
                return;
            }

            let availableRooms =
                responses[0];

            for (let i = 1; i < responses.length; i++) {
                const allowedIds =
                    new Set(
                        responses[i].map(function (room) {
                            return String(room.roomId);
                        })
                    );

                availableRooms =
                    availableRooms.filter(function (room) {
                        return allowedIds.has(
                            String(room.roomId)
                        );
                    });
            }

            roomDropdown.innerHTML =
                '<option value="0">No room assigned</option>';

            if (
                !availableRooms ||
                availableRooms.length === 0
            ) {
                roomDropdown.innerHTML =
                    '<option value="">-- No Rooms Available for All Selected Slots --</option>';

                return;
            }

            availableRooms.forEach(function (room) {
                const option =
                    document.createElement("option");

                option.value =
                    room.roomId;

                option.textContent =
                    room.name;

                roomDropdown.appendChild(option);
            });

            const requestedStillExists =
                Array.from(roomDropdown.options)
                    .some(function (option) {
                        return option.value ===
                            requestedRoomId;
                    });

            if (requestedStillExists) {
                roomDropdown.value =
                    requestedRoomId;
            }
        }
        catch (error) {
            console.error(error);

            roomDropdown.innerHTML =
                '<option value="">-- Error loading available rooms --</option>';
        }
    }


    function openDeleteScheduleModal(
        scheduleId,
        courseCode
    ) {
        document.getElementById("deleteScheduleId").value =
            scheduleId;

        document.getElementById("deleteScheduleMessage").innerText =
            `This will permanently delete the assigned schedule for ${courseCode}. This action cannot be undone.`;

        openModal("deleteScheduleModal");
    }

    function submitDeleteSchedule() {
        const form =
            document.getElementById("deleteScheduleForm");

        if (form) {
            form.submit();
        }
    }

    function openModal(modalId) {
        const modal =
            document.getElementById(modalId);

        if (modal) {
            modal.style.display = "flex";
        }
    }

    function closeModal(modalId) {
        const modal =
            document.getElementById(modalId);

        if (modal) {
            modal.style.display = "none";
        }
    }

    function initializeAlertAutoDismiss() {
        const alerts =
            document.querySelectorAll(".alert-message");

        alerts.forEach(function (alert) {
            setTimeout(function () {
                alert.style.opacity = "0";

                setTimeout(function () {
                    alert.remove();
                }, 500);
            }, 2000);
        });
    }

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            closeModal("editScheduleModal");
            closeModal("deleteScheduleModal");
            closeModal("facultyLoadModal");
        }
    });

    document.addEventListener("click", function (event) {
        const editModal =
            document.getElementById("editScheduleModal");

        const deleteModal =
            document.getElementById("deleteScheduleModal");

        const facultyModal =
            document.getElementById("facultyLoadModal");

        if (event.target === editModal) {
            closeModal("editScheduleModal");
        }

        if (event.target === deleteModal) {
            closeModal("deleteScheduleModal");
        }

        if (event.target === facultyModal) {
            closeModal("facultyLoadModal");
        }
    });
</script>
