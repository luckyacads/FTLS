@page "/ChairmanPage"
@model FTLSV2.Pages.Chairman.ChairmanPageModel
@{
    Layout = "_ChairmanLayout";
    ViewData["Title"] = "Scheduler";
}

<style>
    .btn-edit {
        padding: 7px 12px;
        border: 1px solid #dcdcdc;
        background: white;
        color: #07362d;
        border-radius: 7px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        margin-right: 6px;
    }

        .btn-edit:hover {
            background: #f3f6f5;
            border-color: #07362d;
        }

    .btn-delete {
        padding: 7px 12px;
        border: 1px solid #dc2626;
        background: white;
        color: #dc2626;
        border-radius: 7px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
    }

        .btn-delete:hover {
            background: #fff1f1;
        }

    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(2px);
    }

    .modal-card {
        width: 760px;
        max-width: calc(100% - 40px);
        background: white;
        border-radius: 16px;
        padding: 28px 30px;
        box-shadow: 0 20px 30px rgba(0,0,0,0.16);
        border-left: 6px solid #07362d;
    }

    .modal-card-small {
        width: 420px;
        text-align: center;
        border-left: none;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 18px;
    }

        .modal-header h3 {
            margin: 0;
            color: #111827;
            font-size: 22px;
            font-weight: 700;
        }

    .modal-close {
        border: none;
        background: transparent;
        color: #6b7280;
        cursor: pointer;
        font-size: 26px;
        line-height: 1;
    }

        .modal-close:hover {
            color: #111827;
        }

    .edit-form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }

    .edit-form-group label {
        display: block;
        margin-bottom: 6px;
        font-size: 13px;
        font-weight: 600;
        color: #555;
    }

    .edit-input {
        width: 100%;
        height: 40px;
        padding: 9px 11px;
        border-radius: 7px;
        border: 1px solid #dcdcdc;
        box-sizing: border-box;
        font-size: 14px;
        background: #ffffff;
    }

        .edit-input:focus {
            border-color: #07362d;
            outline: none;
            box-shadow: 0 0 0 2px rgba(7,54,45,0.12);
        }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 18px;
    }

    .center-actions {
        justify-content: center;
    }

    .btn-cancel {
        background: #f3f4f6;
        color: #374151;
        border: none;
        padding: 10px 15px;
        border-radius: 7px;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
    }

        .btn-cancel:hover {
            background: #e5e7eb;
        }

    .btn-danger {
        background: #dc2626;
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 7px;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
    }

        .btn-danger:hover {
            background: #b91c1c;
        }

    .delete-title {
        margin-top: 0;
        color: #111827;
        font-size: 24px;
        font-weight: 700;
    }

    .delete-message {
        font-size: 14px;
        color: #4b5563;
        line-height: 1.5;
        margin-bottom: 24px;
    }

    .action-cell {
        white-space: nowrap;
    }

    @@media (max-width: 800px) {
        .edit-form-grid {
            grid-template-columns: 1fr;
        }

        .modal-card {
            width: calc(100% - 30px);
            padding: 24px 20px;
        }
    }
</style>

<div class="header-bar">
    <h1 class="chairman-title">Scheduler</h1>
</div>

<div style="display: flex; gap: 20px; margin-bottom: 25px;">
    <div class="chairman-card" style="flex: 1; border-left: 5px solid #2ecc71; padding: 12px 20px;">
        <p style="color: #7f8c8d; font-size: 11px; font-weight: bold; text-transform: uppercase; margin-bottom: 2px;">Total Faculty</p>
        <h2 style="margin: 0; color: #07362d; font-size: 24px;">@Model.ActiveFaculty?.Count</h2>
    </div>

    <div class="chairman-card" style="flex: 1; border-left: 5px solid #2ecc71; padding: 12px 20px;">
        <p style="color: #7f8c8d; font-size: 11px; font-weight: bold; text-transform: uppercase; margin-bottom: 2px;">Total Courses</p>
        <h2 style="margin: 0; color: #07362d; font-size: 24px;">@Model.ActiveSubjects?.Count</h2>
    </div>
</div>

<h2 style="margin-bottom: 15px; color: #07362d; font-size: 20px;">Teaching Load Management</h2>

<div style="margin-bottom: 20px;">
    <div class="chairman-card">
        <h3>New Assignment</h3>

        @if (TempData["ErrorMessage"] != null)
        {
            <div style="background-color: #f8d7da; color: #721c24; padding: 12px; margin-bottom: 20px; border-radius: 6px; border-left: 5px solid #dc3545; font-weight: bold;">
                ⚠ @TempData["ErrorMessage"]
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div style="background-color: #d4edda; color: #155724; padding: 12px; margin-bottom: 20px; border-radius: 6px; border-left: 5px solid #28a745; font-weight: bold;">
                ✓ @TempData["SuccessMessage"]
            </div>
        }

        <form id="scheduleForm" method="post">
            <div style="display: flex; gap: 15px; margin-bottom: 15px;">
                <div class="form-group" style="flex: 1;">
                    <label>Faculty Member</label>

                    <select asp-for="SelectedFacultyId" required>
                        <option value="">-- Select Faculty --</option>

                        @if (Model.ActiveFaculty != null)
                        {
                            @foreach (var faculty in Model.ActiveFaculty)
                            {
                                <option value="@faculty.FacultyId">Engr. @faculty.FirstName @faculty.LastName</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group" style="flex: 1;">
                    <label>Course Selection</label>

                    <select asp-for="SelectedSubjectId" required>
                        <option value="">-- Select a Course --</option>

                        @if (Model.ActiveSubjects != null)
                        {
                            @foreach (var subject in Model.ActiveSubjects)
                            {
                                <option value="@subject.SubjectId">@subject.Code - @subject.Title</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;">
                <div class="form-group" style="margin-bottom: 20px; width: 100%;">
                    <label style="display: block; font-weight: bold; color: #07362d; margin-bottom: 8px;">Time Slot</label>

                    <div style="display: flex; align-items: center; gap: 8px; width: 100%;">
                        <select asp-for="SelectedDays" required style="flex: 1.2; min-width: 0; height: 40px; padding: 6px; border: 1px solid #ccc; border-radius: 4px; font-size: 13px; color: #333; cursor: pointer; background-color: #fff;">
                            <option value="" disabled selected>-- Day --</option>
                            <option value="MWF">MWF</option>
                            <option value="TTh">TTh</option>
                            <option value="M">Monday</option>
                            <option value="T">Tuesday</option>
                            <option value="W">Wednesday</option>
                            <option value="Th">Thursday</option>
                            <option value="F">Friday</option>
                            <option value="S">Saturday</option>
                        </select>

                        <input type="time" asp-for="StartTime" required onclick="this.showPicker()" style="flex: 1; min-width: 0; height: 40px; padding: 6px; border: 1px solid #ccc; border-radius: 4px; font-size: 13px; color: #333; cursor: pointer; background-color: #fff;" />

                        <span style="font-weight: bold; color: #555; font-size: 13px;">to</span>

                        <input type="time" asp-for="EndTime" required onclick="this.showPicker()" style="flex: 1; min-width: 0; height: 40px; padding: 6px; border: 1px solid #ccc; border-radius: 4px; font-size: 13px; color: #333; cursor: pointer; background-color: #fff;" />
                    </div>
                </div>

                <div class="form-group">
                    <label>Assigned Room</label>

                    <select asp-for="SelectedRoomId" required style="width: 100%; height: 40px; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;">
                        <option value="">-- Select a Room --</option>

                        @if (Model.AllRooms != null)
                        {
                            @foreach (var room in Model.AllRooms)
                            {
                                <option value="@room.RoomId">@room.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Offer Code</label>

                    <input type="number"
                           asp-for="SelectedOfferCode"
                           required
                           style="width: 100%; height: 40px; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;"
                           placeholder="Enter offer code" />
                </div>

                <div class="form-group">
                    <label>Academic Year</label>

                    <select asp-for="SelectedAcademicYear" required style="width: 100%; height: 40px; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;">
                        <option value="">-- Select Academic Year --</option>

                        @if (Model.AvailableAcademicYears != null)
                        {
                            @foreach (var year in Model.AvailableAcademicYears)
                            {
                                <option value="@year">@year</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <button type="submit" class="btn-primary">Assign Schedule</button>
        </form>
    </div>
</div>

<div class="chairman-card" style="margin-top: 20px; width: 100%;">
    <h3>Assigned Teaching Loads</h3>

    <table class="table-light" style="width: 100%;">
        <thead>
            <tr>
                <th>Faculty</th>
                <th>Course</th>
                <th>Schedule</th>
                <th>Room</th>
                <th>Offer Code</th>
                <th>Academic Year</th>
                <th>Semester</th>
                <th>Load Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.CurrentSchedules != null && Model.CurrentSchedules.Any())
            {
                @foreach (var load in Model.CurrentSchedules)
                {
                    <tr>
                        <td>@load.FacultyName</td>
                        <td>@load.CourseCode</td>
                        <td>@load.Schedule</td>
                        <td>@load.RoomName</td>
                        <td>@load.OfferCode</td>
                        <td>@load.AcademicYear</td>
                        <td>@load.Semester</td>
                        <td><span class="badge badge-success">Assigned</span></td>
                        <td class="action-cell">
                            <button type="button"
                                    class="btn-edit"
                                    onclick='openEditScheduleModal(
                                @load.ScheduleId,
                                @load.FacultyId,
                                @load.SubjectId,
                                @(load.RoomId ?? 0),
                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(load.Schedule ?? "")),
                                @(load.OfferCode ?? 0),
                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(load.AcademicYear ?? ""))
                                )'>
                                Edit
                            </button>

                            <button type="button"
                                    class="btn-delete"
                                    onclick='openDeleteScheduleModal(
                                @load.ScheduleId,
                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(load.CourseCode ?? "this course"))
                                )'>
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" style="text-align: center; padding: 18px; color: #777;">
                        No assigned teaching loads found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="editScheduleModal" class="modal-overlay">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Edit Assigned Schedule</h3>
            <button type="button" class="modal-close" onclick="closeModal('editScheduleModal')">×</button>
        </div>

        <form method="post" asp-page-handler="EditSchedule">
            <input type="hidden" asp-for="EditScheduleId" id="editScheduleId" />

            <div class="edit-form-grid">
                <div class="edit-form-group">
                    <label asp-for="EditFacultyId">Faculty</label>
                    <select asp-for="EditFacultyId" id="editFacultyId" class="edit-input" required>
                        <option value="">Select Faculty</option>
                        @if (Model.ActiveFaculty != null)
                        {
                            @foreach (var faculty in Model.ActiveFaculty)
                            {
                                <option value="@faculty.FacultyId">Engr. @faculty.FirstName @faculty.LastName</option>
                            }
                        }
                    </select>
                </div>

                <div class="edit-form-group">
                    <label asp-for="EditSubjectId">Subject</label>
                    <select asp-for="EditSubjectId" id="editSubjectId" class="edit-input" required>
                        <option value="">Select Subject</option>
                        @if (Model.ActiveSubjects != null)
                        {
                            @foreach (var subject in Model.ActiveSubjects)
                            {
                                <option value="@subject.SubjectId">@subject.Code - @subject.Title (@subject.Units units)</option>
                            }
                        }
                    </select>
                </div>

                <div class="edit-form-group">
                    <label asp-for="EditDays">Days</label>
                    <select asp-for="EditDays" id="editDays" class="edit-input" required>
                        <option value="">Select Days</option>
                        <option value="MWF">MWF</option>
                        <option value="TTh">TTh</option>
                        <option value="M">Monday</option>
                        <option value="T">Tuesday</option>
                        <option value="W">Wednesday</option>
                        <option value="Th">Thursday</option>
                        <option value="F">Friday</option>
                        <option value="S">Saturday</option>
                    </select>
                </div>

                <div class="edit-form-group">
                    <label asp-for="EditRoomId">Room</label>
                    <select asp-for="EditRoomId" id="editRoomId" class="edit-input" required>
                        <option value="0">No room assigned</option>
                        @if (Model.AllRooms != null)
                        {
                            @foreach (var room in Model.AllRooms)
                            {
                                <option value="@room.RoomId">@room.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="edit-form-group">
                    <label asp-for="EditStartTime">Start Time</label>
                    <input asp-for="EditStartTime" id="editStartTime" type="time" class="edit-input" required onclick="this.showPicker()" />
                </div>

                <div class="edit-form-group">
                    <label asp-for="EditEndTime">End Time</label>
                    <input asp-for="EditEndTime" id="editEndTime" type="time" class="edit-input" required onclick="this.showPicker()" />
                </div>

                <div class="edit-form-group">
                    <label asp-for="EditOfferCode">Offer Code</label>
                    <input asp-for="EditOfferCode" id="editOfferCode" type="number" class="edit-input" />
                </div>

                <div class="edit-form-group">
                    <label asp-for="EditAcademicYear">Academic Year</label>
                    <select asp-for="EditAcademicYear" id="editAcademicYear" class="edit-input" required>
                        <option value="">Select Academic Year</option>
                        @if (Model.AvailableAcademicYears != null)
                        {
                            @foreach (var year in Model.AvailableAcademicYears)
                            {
                                <option value="@year">@year</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeModal('editScheduleModal')">
                    Cancel
                </button>

                <button type="submit" class="btn-primary">
                    Update Schedule
                </button>
            </div>
        </form>
    </div>
</div>

<form method="post" asp-page-handler="DeleteSchedule" id="deleteScheduleForm" style="display:none;">
    <input type="hidden" asp-for="DeleteScheduleId" id="deleteScheduleId" />
</form>

<div id="deleteScheduleModal" class="modal-overlay">
    <div class="modal-card modal-card-small">
        <h3 class="delete-title">Are you sure?</h3>

        <p id="deleteScheduleMessage" class="delete-message"></p>

        <div class="modal-actions center-actions">
            <button type="button" class="btn-cancel" onclick="closeModal('deleteScheduleModal')">
                Cancel
            </button>

            <button type="button" class="btn-danger" onclick="submitDeleteSchedule()">
                Delete
            </button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const daysInput = document.getElementById("SelectedDays");
        const startInput = document.getElementById("StartTime");
        const endInput = document.getElementById("EndTime");
        const roomDropdown = document.getElementById("SelectedRoomId");

        if (daysInput && startInput && endInput && roomDropdown) {
            daysInput.addEventListener("change", fetchAvailableRooms);
            startInput.addEventListener("change", fetchAvailableRooms);
            endInput.addEventListener("change", fetchAvailableRooms);
        }

        const editDaysInput = document.getElementById("editDays");
        const editStartInput = document.getElementById("editStartTime");
        const editEndInput = document.getElementById("editEndTime");

        if (editDaysInput && editStartInput && editEndInput) {
            editDaysInput.addEventListener("change", fetchAvailableRoomsForEdit);
            editStartInput.addEventListener("change", fetchAvailableRoomsForEdit);
            editEndInput.addEventListener("change", fetchAvailableRoomsForEdit);
        }

        function fetchAvailableRooms() {
            const days = daysInput.value;
            const start = startInput.value;
            const end = endInput.value;

            if (days && start && end) {
                roomDropdown.innerHTML = '<option value="">Searching for available rooms...</option>';

                fetch(`?handler=AvailableRooms&days=${encodeURIComponent(days)}&startTime=${encodeURIComponent(start)}&endTime=${encodeURIComponent(end)}`)
                    .then(response => response.json())
                    .then(data => {
                        roomDropdown.innerHTML = '';

                        if (!data || data.length === 0) {
                            roomDropdown.innerHTML = '<option value="">-- No Rooms Available at this Time! --</option>';
                        } else {
                            roomDropdown.innerHTML = '<option value="">-- Select an Available Room --</option>';

                            data.forEach(room => {
                                const option = document.createElement("option");
                                option.value = room.roomId;
                                option.textContent = room.name;
                                roomDropdown.appendChild(option);
                            });
                        }
                    })
                    .catch(error => {
                        console.error("Error fetching rooms:", error);
                        roomDropdown.innerHTML = '<option value="">-- Error loading rooms --</option>';
                    });
            }
        }
    });

    function openEditScheduleModal(scheduleId, facultyId, subjectId, roomId, scheduleText, offerCode, academicYear) {
        document.getElementById("editScheduleId").value = scheduleId;
        document.getElementById("editFacultyId").value = facultyId;
        document.getElementById("editSubjectId").value = subjectId;
        document.getElementById("editRoomId").value = roomId || 0;
        document.getElementById("editOfferCode").value = offerCode ?? "";
        document.getElementById("editAcademicYear").value = academicYear || "";

        const parsed = parseScheduleText(scheduleText);

        if (parsed) {
            document.getElementById("editDays").value = parsed.days;
            document.getElementById("editStartTime").value = parsed.startTime;
            document.getElementById("editEndTime").value = parsed.endTime;
        }

        openModal("editScheduleModal");

        fetchAvailableRoomsForEdit(roomId || 0);
    }

    function parseScheduleText(scheduleText) {
        if (!scheduleText) {
            return null;
        }

        const parts = scheduleText.trim().split(/\s+/);

        if (parts.length < 6) {
            return null;
        }

        const days = parts[0];
        const startRaw = `${parts[1]} ${parts[2]}`;
        const endRaw = `${parts[4]} ${parts[5]}`;

        return {
            days: days,
            startTime: convertToTimeInputValue(startRaw),
            endTime: convertToTimeInputValue(endRaw)
        };
    }

    function convertToTimeInputValue(timeText) {
        const date = new Date(`1970-01-01 ${timeText}`);

        if (isNaN(date.getTime())) {
            return "";
        }

        const hours = String(date.getHours()).padStart(2, "0");
        const minutes = String(date.getMinutes()).padStart(2, "0");

        return `${hours}:${minutes}`;
    }

    function fetchAvailableRoomsForEdit(currentRoomId = null) {
        const scheduleId = document.getElementById("editScheduleId").value;
        const days = document.getElementById("editDays").value;
        const start = document.getElementById("editStartTime").value;
        const end = document.getElementById("editEndTime").value;
        const editRoomDropdown = document.getElementById("editRoomId");

        const previouslySelectedRoomId = currentRoomId || editRoomDropdown.value || 0;

        if (!days || !start || !end) {
            return;
        }

        editRoomDropdown.innerHTML = '<option value="">Searching for available rooms...</option>';

        fetch(`?handler=AvailableRooms&days=${encodeURIComponent(days)}&startTime=${encodeURIComponent(start)}&endTime=${encodeURIComponent(end)}&excludeScheduleId=${encodeURIComponent(scheduleId)}`)
            .then(response => response.json())
            .then(data => {
                editRoomDropdown.innerHTML = '<option value="0">No room assigned</option>';

                if (!data || data.length === 0) {
                    const option = document.createElement("option");
                    option.value = "";
                    option.textContent = "-- No Rooms Available at this Time! --";
                    editRoomDropdown.appendChild(option);
                    return;
                }

                data.forEach(room => {
                    const option = document.createElement("option");
                    option.value = room.roomId;
                    option.textContent = room.name;
                    editRoomDropdown.appendChild(option);
                });

                editRoomDropdown.value = previouslySelectedRoomId;
            })
            .catch(error => {
                console.error("Error fetching edit rooms:", error);
                editRoomDropdown.innerHTML = '<option value="">-- Error loading rooms --</option>';
            });
    }

    function openDeleteScheduleModal(scheduleId, courseCode) {
        document.getElementById("deleteScheduleId").value = scheduleId;

        document.getElementById("deleteScheduleMessage").innerText =
            `This will permanently delete the assigned schedule for ${courseCode}. This action cannot be undone.`;

        openModal("deleteScheduleModal");
    }

    function submitDeleteSchedule() {
        const form = document.getElementById("deleteScheduleForm");

        if (form) {
            form.submit();
        }
    }

    function openModal(modalId) {
        const modal = document.getElementById(modalId);

        if (modal) {
            modal.style.display = "flex";
        }
    }

    function closeModal(modalId) {
        const modal = document.getElementById(modalId);

        if (modal) {
            modal.style.display = "none";
        }
    }

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            closeModal("editScheduleModal");
            closeModal("deleteScheduleModal");
        }
    });

    document.addEventListener("click", function (event) {
        const editModal = document.getElementById("editScheduleModal");
        const deleteModal = document.getElementById("deleteScheduleModal");

        if (event.target === editModal) {
            closeModal("editScheduleModal");
        }

        if (event.target === deleteModal) {
            closeModal("deleteScheduleModal");
        }
    });
</script>