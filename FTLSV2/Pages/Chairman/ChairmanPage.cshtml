                                <input type="checkbox" name="SelectedDays" value="M" data-schedule-day="M" @(Model.SelectedDays?.Contains("M") == true ? "checked" : "") />
                                <span>M</span>
                            </label>

                            <label class="schedule-day-chip">
                                <input type="checkbox" name="SelectedDays" value="T" data-schedule-day="T" @(Model.SelectedDays?.Contains("T") == true ? "checked" : "") />
                                <span>T</span>
                            </label>

                            <label class="schedule-day-chip">
                                <input type="checkbox" name="SelectedDays" value="W" data-schedule-day="W" @(Model.SelectedDays?.Contains("W") == true ? "checked" : "") />
                                <span>W</span>
                            </label>

                            <label class="schedule-day-chip">
                                <input type="checkbox" name="SelectedDays" value="Th" data-schedule-day="Th" @(Model.SelectedDays?.Contains("Th") == true ? "checked" : "") />
                                <span>Th</span>
                            </label>

                            <label class="schedule-day-chip">
                                <input type="checkbox" name="SelectedDays" value="F" data-schedule-day="F" @(Model.SelectedDays?.Contains("F") == true ? "checked" : "") />
                                <span>F</span>
                            </label>

