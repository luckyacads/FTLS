@page "/ChairmanPage"
@model FTLSV2.Pages.Chairman.ChairmanPageModel
@{
    Layout = "_ChairmanLayout";
    ViewData["Title"] = "Dashboard Overview";
}

<div class="header-bar">
    <h1 class="chairman-title">Dashboard Overview</h1>
    <button class="btn-print" onclick="window.print()">Print Faculty Loads</button>
</div>

<div style="display: flex; gap: 20px; margin-bottom: 25px;">
    <div class="chairman-card" style="flex: 1; border-left: 5px solid #2ecc71; padding: 12px 20px;">
        <p style="color: #7f8c8d; font-size: 11px; font-weight: bold; text-transform: uppercase; margin-bottom: 2px;">Total Faculty</p>
        <h2 style="margin: 0; color: #07362d; font-size: 24px;">@Model.ActiveTeachers?.Count</h2>
    </div>

    <div class="chairman-card" style="flex: 1; border-left: 5px solid #2ecc71; padding: 12px 20px;">
        <p style="color: #7f8c8d; font-size: 11px; font-weight: bold; text-transform: uppercase; margin-bottom: 2px;">Total Courses</p>
        <h2 style="margin: 0; color: #07362d; font-size: 24px;">@Model.ActiveSubjects?.Count</h2>
    </div>
</div>

<h2 style="margin-bottom: 15px; color: #07362d; font-size: 20px;">Teaching Load Management</h2>

<div class="card-grid" style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px;">

    <div class="chairman-card">
        <h3>New Assignment</h3>

        @if (TempData["ErrorMessage"] != null)
        {
            <div style="background-color: #f8d7da; color: #721c24; padding: 12px; margin-bottom: 20px; border-radius: 6px; border-left: 5px solid #dc3545; font-weight: bold;">
                ⚠ @TempData["ErrorMessage"]
            </div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div style="background-color: #d4edda; color: #155724; padding: 12px; margin-bottom: 20px; border-radius: 6px; border-left: 5px solid #28a745; font-weight: bold;">
                ✓ @TempData["SuccessMessage"]
            </div>
        }

        <form id="scheduleForm" method="post">

            <div style="display: flex; gap: 15px; margin-bottom: 15px;">
                <div class="form-group" style="flex: 1;">
                    <label>Faculty Member</label>
                    <select asp-for="SelectedFacultyId" required>
                        <option value="0">-- Select a Teacher --</option>
                        @if (Model.ActiveTeachers != null)
                        {
                            @foreach (var teacher in Model.ActiveTeachers)
                            {
                                <option value="@teacher.Id">Engr. @teacher.FirstName @teacher.LastName</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group" style="flex: 1;">
                    <label>Course Selection</label>
                    <select asp-for="SelectedSubjectId" required>
                        <option value="">-- Select a Course --</option>
                        @if (Model.ActiveSubjects != null)
                        {
                            @foreach (var subject in Model.ActiveSubjects)
                            {
                                <option value="@subject.SubjectId">@subject.Code - @subject.Title</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;">

                <div class="form-group">
                    <label>Time Slot</label>
                    <input type="text" asp-for="InputTimeSlot" placeholder="e.g., TTH 1:00 PM - 2:30 PM" required style="width: 300px; height: 40px; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;" />
                </div>

                <div class="form-group">
                    <label>Assigned Room</label>
                    <select asp-for="SelectedRoomId" required style="width: 300px; height: 40px; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;">
                        <option value="">-- Select a Room --</option>
                        @if (Model.AllRooms != null)
                        {
                            @foreach (var room in Model.AllRooms)
                            {
                                @if (room.Availability == "Booked")
                                {
                                    <option value="@room.RoomId" disabled>@room.Name (Booked)</option>
                                }
                                else
                                {
                                    <option value="@room.RoomId">@room.Name (Available)</option>
                                }
                            }
                        }
                    </select>
                </div>

            </div>

            <button type="submit" class="btn-primary">Finalize Assignment</button>
        </form>
    </div>

    <div class="chairman-card">
        <h3>System Constraints</h3>
        <p><strong>Global Max Limit:</strong> @FTLSV2.Pages.AdminPageModel.CurrentMaxOverload Units</p>
        <p style="color: #7f8c8d; font-size: 13px; margin-top: 5px;">*Teachers have individual custom limits assigned by the Admin.</p>
        <hr style="border: 0; border-top: 1px solid #eee; margin: 15px 0;">
        <p><small>System checking for overlaps and double-booking in real-time.</small></p>
    </div>

</div>

<div class="chairman-card" style="margin-top: 20px; width: 100%;">
    <h3>Assigned Teaching Loads (Current Semester)</h3>
    <table class="table-light" style="width: 100%;">
        <thead>
            <tr>
                <th>Faculty</th>
                <th>Course</th>
                <th>Schedule</th>
                <th>Room</th>
                <th>Load Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.CurrentSchedules != null)
            {
                @foreach (var load in Model.CurrentSchedules)
                {
                    <tr>
                        <td>@load.FacultyName</td>
                        <td>@load.CourseCode</td>
                        <td>@load.Schedule</td>
                        <td>@load.RoomName</td>
                        <td><span class="badge badge-success">Assigned</span></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>