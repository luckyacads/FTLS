    function updateSelectedDayRows() {
        const mode =
            getSelectedScheduleMode();

        document
            .querySelectorAll("[data-schedule-day]")
            .forEach(function (checkbox) {
                const day =
                    checkbox.dataset.scheduleDay;

                const row =
                    document.querySelector(`[data-flex-row="${day}"]`);

                const startInput =
                    document.querySelector(`[data-day-start="${day}"]`);

                const endInput =
                    document.querySelector(`[data-day-end="${day}"]`);

                if (!startInput || !endInput) {
                    return;
                }

                if (mode === "custom") {
                    if (checkbox.checked) {
                        row?.classList.add("active");

                        startInput.disabled = false;
                        endInput.disabled = false;

                        startInput.required = true;
                        endInput.required = true;
                    }
                    else {
                        row?.classList.remove("active");

                        startInput.disabled = true;
                        endInput.disabled = true;

                        startInput.required = false;
                        endInput.required = false;

                        startInput.value = "";
                        endInput.value = "";
                        endInput.setCustomValidity("");
                    }
                }
                else {
                    row?.classList.remove("active");

                    /*
                     * In common mode the per-day fields stay enabled only for
                     * selected days so the form still posts DayStartTimes[]
                     * and DayEndTimes[] using the same values for every day.
                     */
                    startInput.disabled = !checkbox.checked;
                    endInput.disabled = !checkbox.checked;

                    startInput.required = false;
                    endInput.required = false;

                    if (!checkbox.checked) {
                        startInput.value = "";
                        endInput.value = "";
                    }
                }
            });

        if (mode === "common") {
            syncCommonTimeToSelectedDays();
        }
    }

    function syncCommonTimeToSelectedDays() {
        if (getSelectedScheduleMode() !== "common") {
            return;
        }

        const commonStart =
            document.getElementById("commonStartTime");

        const commonEnd =
            document.getElementById("commonEndTime");

        document
            .querySelectorAll("[data-schedule-day]")
            .forEach(function (checkbox) {
