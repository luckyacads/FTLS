    function parseScheduleText(scheduleText) {
        if (!scheduleText) {
            return null;
        }

        const match = scheduleText.match(
            /^([A-Za-z,\s]+)\s(\d{1,2}:\d{2}\s*(?:AM|PM))\s-\s(\d{1,2}:\d{2}\s*(?:AM|PM))$/i
        );

        if (!match || match.length !== 4) {
            return null;
        }

        const rawDays =
            match[1].trim();

        let daysArray;

        if (rawDays.includes(",")) {
            daysArray =
                rawDays
                    .split(",")
                    .map(function (day) {
                        return day.trim();
                    });
        }
        else {
            daysArray =
                parseCompactDays(rawDays);
        }

        return {
            days: daysArray,
            startTime: convertToTimeInputValue(match[2]),
            endTime: convertToTimeInputValue(match[3])
        };
    }

    function parseCompactDays(rawDays) {
        const result = [];
        let i = 0;

        while (i < rawDays.length) {
            if (
                rawDays.substring(i, i + 2)
                    .toLowerCase() === "th"
            ) {
                result.push("Th");
                i += 2;
                continue;
            }

            const token =
                rawDays.charAt(i);

            if (
                ["M", "T", "W", "F", "S"]
                    .includes(token)
            ) {
                result.push(token);
            }

            i++;
        }

        return result;
    }

    function convertToTimeInputValue(timeText) {
        if (!timeText) {
            return "";
        }

        const match = timeText.match(
            /^(\d{1,2}):(\d{2})\s*(AM|PM)$/i
        );

        if (!match) {
            return "";
        }

        let hours =
            parseInt(match[1], 10);

        const minutes =
            match[2];

        const ampm =
            match[3].toUpperCase();

        if (ampm === "PM" && hours < 12) {
            hours += 12;
        }
        else if (ampm === "AM" && hours === 12) {
            hours = 0;
        }

        return `${String(hours).padStart(2, "0")}:${minutes}`;
    }

