@page
@model FTLSV2.Pages.Chairman.AccountSettingsModel
@{
    ViewData["Title"] = "Account Settings";
    Layout = "_ChairmanLayout";
}

@section Styles {
    <style>
        .account-wrapper {
            max-width: 800px;
            margin: 0 auto;
            width: 100%;
            padding-top: 10px;
        }

        .account-grid {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .card {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
            border: 1px solid #e5e7eb;
        }

            .card h3 {
                margin-top: 0;
                color: #111827;
                font-size: 18px;
                border-bottom: 2px solid #f3f4f6;
                padding-bottom: 12px;
                margin-bottom: 20px;
                font-weight: 700;
            }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

            .form-group.full {
                grid-column: span 2;
            }

        label {
            font-weight: 600;
            font-size: 13px;
            color: #4b5563;
        }

        .input {
            width: 100%;
            height: 42px;
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid #d1d5db;
            box-sizing: border-box;
            font-size: 14px;
            transition: all 0.2s ease;
        }

            .input:focus {
                outline: none;
                border-color: #07362d;
                box-shadow: 0 0 0 3px rgba(7, 54, 45, 0.08);
            }

            /* Clean read-only visual state */
            .input:disabled {
                background: #f8fafc;
                color: #64748b;
                border-color: #e2e8f0;
                cursor: not-allowed;
                font-weight: 500;
            }

        .password-hint {
            font-size: 12px;
            color: #6b7280;
            margin-top: 2px;
        }

        .btn-primary {
            background: #07362d;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            margin-top: 10px;
            transition: background 0.2s;
            box-shadow: 0 2px 4px rgba(7, 54, 45, 0.15);
        }

            .btn-primary:hover {
                background: #0a4d40;
            }

        .alert {
            padding: 14px 16px;
            border-radius: 8px;
            margin-top: 20px;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .alert.error {
                background: #fde8e8;
                color: #991b1b;
                border-left: 4px solid #ef4444;
            }

            .alert.success {
                background: #e1f5ee;
                color: #0f6e56;
                border-left: 4px solid #10b981;
            }

        @@media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full {
                grid-column: span 1;
            }
        }
    </style>
}

<div class="account-wrapper">
    <header style="margin-bottom: 25px;">
        <h1 style="color: #07362d; margin: 0; font-weight: 700; font-size: 26px;">Account Settings</h1>
    </header>

    <div class="account-grid">

        <section class="card">
            <h3>Profile Information</h3>
            <div class="form-grid">
                <div class="form-group">
                    <label>First Name</label>
                    <input class="input" value="@Model.LoggedInUser?.FirstName" disabled />
                </div>

                <div class="form-group">
                    <label>Last Name</label>
                    <input class="input" value="@Model.LoggedInUser?.LastName" disabled />
                </div>

                <div class="form-group full">
                    <label>Email Address</label>
                    <input class="input" value="@Model.LoggedInUser?.Email" disabled />
                </div>

                <div class="form-group full">
                    <label>Faculty Identification ID</label>
                    <input class="input" value="@Model.LoggedInUser?.FacultyId" disabled />
                </div>
            </div>
        </section>

        <section class="card">
            <h3>Change Password</h3>

            <form method="post" asp-page-handler="ChangePassword">
                <div class="form-grid">
                    <div class="form-group full">
                        <label>Current Password</label>
                        <input type="password" class="input" asp-for="CurrentPassword" placeholder="Enter your current password" required />
                    </div>

                    <div class="form-group full">
                        <label>New Password</label>
                        <input type="password" class="input" asp-for="NewPassword" placeholder="Minimum 8 characters" required />
                        <span class="password-hint">Password must be at least 8 characters long.</span>
                    </div>

                    <div class="form-group full">
                        <label>Confirm New Password</label>
                        <input type="password" class="input" asp-for="ConfirmNewPassword" placeholder="Retype your new password" required />
                    </div>
                </div>

                <button type="submit" class="btn-primary">Update Password</button>
            </form>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert error">
                    <svg style="width:20px; height:20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    @Model.ErrorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert success">
                    <svg style="width:20px; height:20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    @Model.SuccessMessage
                </div>
            }
        </section>

    </div>
</div>