@page "/Chairman/RoomUtilization"
@model FTLSV2.Pages.Chairman.RoomUtilizationModel
@{
    ViewData["Title"] = "Room Utilization";
    Layout = "_ChairmanLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/chairman.css" />

    <style>
        .room-utilization-page {
            padding: 22px 28px;
        }

        .room-utilization-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-bottom: 18px;
        }

        .room-utilization-title {
            margin: 0;
            font-size: 28px;
            font-weight: 800;
            color: #07362d;
        }

        .room-utilization-subtitle {
            margin-top: 6px;
            font-size: 14px;
            color: #6b7280;
        }

        .calendar-legend {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .legend-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 700;
            color: #374151;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 999px;
            padding: 7px 11px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.04);
        }

        .legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            display: inline-block;
        }

        .legend-occupied {
            background: #c9f7df;
            border: 1px solid #8ee6b8;
        }

        .chairman-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 8px 22px rgba(0,0,0,0.06);
        }

        .room-accordion {
            margin-bottom: 18px;
            background: transparent;
        }

            .room-accordion summary {
                background: #ffe600;
                padding: 15px 18px;
                border-radius: 22px;
                font-weight: 800;
                color: #800000;
                cursor: pointer;
                list-style: none;
                display: flex;
                justify-content: space-between;
                align-items: center;
                box-shadow: 0 2px 6px rgba(0,0,0,0.10);
            }

                .room-accordion summary::-webkit-details-marker {
                    display: none;
                }

                .room-accordion summary::after {
                    content: '▼';
                    font-size: 1.1em;
                    margin-left: 12px;
                }

            .room-accordion[open] summary::after {
                content: '▲';
            }

        .room-summary-left {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .room-name {
            font-size: 16px;
        }

        .room-meta {
            font-size: 12px;
            font-weight: 700;
            color: #5f1b1b;
            opacity: 0.85;
        }

        .calendar-wrapper {
            margin-top: 14px;
            overflow-x: auto;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            background: #ffffff;
        }

        .calendar-grid {
            min-width: 1040px;
            border-radius: 14px;
            overflow: hidden;
        }

        .calendar-header {
            display: grid;
            grid-template-columns: 88px repeat(6, 1fr);
            border-bottom: 1px solid #e5e7eb;
            background: #ffffff;
        }

        .time-header {
            padding: 13px 12px;
            font-size: 13px;
            font-weight: 800;
            color: #374151;
            border-right: 1px solid #e5e7eb;
        }

        .day-header {
            padding: 11px 12px;
            text-align: center;
            border-right: 1px solid #e5e7eb;
        }

            .day-header:last-child {
                border-right: none;
            }

        .day-short {
            display: block;
            font-size: 11px;
            font-weight: 800;
            color: #6b7280;
            letter-spacing: 0.5px;
        }

        .day-full {
            display: block;
            margin-top: 3px;
            font-size: 13px;
            font-weight: 800;
            color: #111827;
        }

        .calendar-body {
            display: grid;
            grid-template-columns: 88px repeat(6, 1fr);
        }

        .time-column {
            height: var(--calendar-height);
            position: relative;
            border-right: 1px solid #e5e7eb;
            background: #fbfbfc;
        }

        .time-marker {
            position: absolute;
            right: 12px;
            transform: translateY(-50%);
            font-size: 12px;
            color: #4b5563;
            white-space: nowrap;
        }

        .day-column {
            height: var(--calendar-height);
            position: relative;
            border-right: 1px solid #e5e7eb;
            background-color: #ffffff;
            background-image: linear-gradient(to bottom, #eef0f3 1px, transparent 1px);
            background-size: 100% var(--half-hour-height);
        }

            .day-column:last-child {
                border-right: none;
            }

        .schedule-card {
            position: absolute;
            left: 10px;
            right: 10px;
            background: #d5f8e6;
            border: 1px solid #a7ebc7;
            border-left: 5px solid #21a366;
            border-radius: 10px;
            padding: 11px 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.10);
            overflow: hidden;
            color: #064e3b;
            box-sizing: border-box;
        }

        .schedule-card-header {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 6px;
            min-width: 0;
            margin-bottom: 7px;
        }

        .schedule-title {
            display: block;
            width: 100%;
            font-size: 13px;
            font-weight: 800;
            line-height: 1.25;
            white-space: normal;
            overflow: visible;
            text-overflow: unset;
            word-break: normal;
            overflow-wrap: break-word;
        }

        .schedule-status {
            display: inline-block;
            font-size: 8px;
            font-weight: 800;
            color: #047857;
            background: rgba(255,255,255,0.75);
            border-radius: 999px;
            padding: 3px 7px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .schedule-time {
            display: block;
            font-size: 12px;
            font-weight: 700;
            color: #065f46;
            line-height: 1.35;
            white-space: normal;
            overflow: visible;
            text-overflow: unset;
        }

        .empty-room-note {
            padding: 16px;
            color: #6b7280;
            font-size: 14px;
            font-weight: 600;
        }

        @@media (max-width: 900px) {
            .room-utilization-page {
                padding: 18px 16px;
            }

            .room-utilization-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .room-utilization-title {
                font-size: 24px;
            }
        }
    </style>
}

<div class="room-utilization-page">
    <div class="room-utilization-header">
        <div>
            <h1 class="room-utilization-title">Room Utilization</h1>
            <div class="room-utilization-subtitle">
                Weekly calendar view of room schedules. Empty spaces indicate available time slots.
            </div>
        </div>

        <div class="calendar-legend">
            <span class="legend-item">
                <span class="legend-dot legend-occupied"></span>
                Occupied
            </span>
        </div>
    </div>

    <div class="chairman-card">
        @if (Model.Rooms.Any())
        {
            @foreach (var room in Model.Rooms)
            {
                <details class="room-accordion">
                    <summary>
                        <span class="room-summary-left">
                            <span class="room-name">@room.RoomName</span>
                            <span class="room-meta">Capacity: @room.Capacity | Scheduled classes: @room.TotalEvents</span>
                        </span>
                    </summary>

                    <div class="calendar-wrapper">
                        <div class="calendar-grid"
                             style="--calendar-height: @(Model.CalendarHeightPixels)px; --half-hour-height: @(Model.HalfHourHeightPixels)px;">
                            <div class="calendar-header">
                                <div class="time-header">Time</div>

                                @foreach (var day in room.WeekDays)
                                {
                                    <div class="day-header">
                                        <span class="day-short">@day.ShortLabel</span>
                                        <span class="day-full">@day.Label</span>
                                    </div>
                                }
                            </div>

                            <div class="calendar-body">
                                <div class="time-column">
                                    @foreach (var marker in Model.TimeMarkers)
                                    {
                                        <div class="time-marker" style="top: @(marker.TopPixels)px;">
                                            @marker.Label
                                        </div>
                                    }
                                </div>

                                @foreach (var day in room.WeekDays)
                                {
                                    <div class="day-column">
                                        @foreach (var schedule in day.Events)
                                        {
                                            <div class="schedule-card"
                                                 title="@schedule.Title (@schedule.StartTimeText - @schedule.EndTimeText)"
                                                 style="top: @(schedule.TopPixels)px; height: @(schedule.HeightPixels)px;">
                                                <div class="schedule-card-header">
                                                    <span class="schedule-title">@schedule.Title</span>
                                                    <span class="schedule-status">Occupied</span>
                                                </div>

                                                <span class="schedule-time">@schedule.StartTimeText - @schedule.EndTimeText</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </details>
            }
        }
        else
        {
            <div class="empty-room-note">
                No rooms found in the room registry.
            </div>
        }
    </div>
</div>