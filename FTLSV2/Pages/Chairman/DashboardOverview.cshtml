@page "/Chairman/DashboardOverview"
@model FTLSV2.Pages.Chairman.DashboardOverviewModel
@{
    ViewData["Title"] = "Dashboard Overview";
    Layout = "_ChairmanLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/chairman.css" />
}

        <h1 class="chairman-title">Dashboard Overview</h1>
        <div class="chairman-card">
            <p>Summary widgets and quick actions for the current semester.</p>
            <div style="display:flex;gap:20px;margin-top:12px">
                <div style="flex:1;background:#fff;padding:12px;border-radius:6px;box-shadow:0 2px 6px rgba(0,0,0,0.04)">
                    <strong>Total Faculty</strong>
                    <div style="font-size:22px;color:#243b45">@Model.TotalFaculty</div>
                </div>
                <div style="flex:1;background:#fff;padding:12px;border-radius:6px;box-shadow:0 2px 6px rgba(0,0,0,0.04)">
                    <strong>Total Courses</strong>
                    <div style="font-size:22px;color:#243b45">@Model.TotalCourses</div>
                </div>
            </div>
        </div>
        <div class="chairman-card">
            <h4>Assigned Teaching Loads</h4>
            <table class="table-light">
                <thead>
                    <tr><th>Faculty</th><th>Course</th><th>Schedule</th><th>Room</th></tr>
                </thead>
                <tbody>
                    @foreach(var a in Model.Assignments)
                    {
                        <tr>
                            <td>@a.Faculty</td>
                            <td>@a.Course</td>
                            <td>@a.Schedule</td>
                            <td>@a.Room</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
