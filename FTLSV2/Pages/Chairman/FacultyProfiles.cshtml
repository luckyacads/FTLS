@page "/Chairman/FacultyProfiles"
@model FTLSV2.Pages.Chairman.FacultyProfilesModel
@{
    ViewData["Title"] = "Faculty Profiles";
    Layout = "_ChairmanLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/chairman.css" />
}

<h1 class="chairman-title">Faculty Profiles</h1>

<div class="chairman-card">
    <h4>Faculty Directory</h4>

    <table class="table-light">
        <thead>
            <tr>
                <th>ID</th>
                <th>Faculty ID</th>
                <th>Name</th>
                <th>Role</th>
                <th>Current Units</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var f in Model.FacultyList)
            {
                <tr>
                    <td>@f.Id</td>
                    <td>@f.FacultyId</td>
                    <td>@f.Name</td>
                    <td>@f.Role</td>
                    <td>@f.CurrentUnitsDisplay</td>
                </tr>
            }
        </tbody>
    </table>
</div>