@page
@model FTLSV2.Pages.Chairman.RegisterTeacherModel
@{
    ViewData["Title"] = "Register Teacher";
    Layout = "_ChairmanLayout";
}

<style>
    .success-box {
        background: #e8fff1;
        color: #0d6b37;
        border-left: 5px solid #27ae60;
    }

    .error-box {
        background: #fff1f1;
        color: #b42318;
        border-left: 5px solid #e74c3c;
    }
</style>

<div class="register-wrapper">
    <div class="register-card">

        <div class="register-header">
            <h1>Register New Teacher</h1>
            <p>Create a faculty teaching account under your department</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="message-box @(Model.IsSuccess ? "success-box" : "error-box")">
                @Model.Message
            </div>
        }

        <form method="post" class="register-form">

            <div class="form-grid">

                <div class="form-group">
                    <label>Faculty ID</label>
                    <input asp-for="FacultyId"
                           maxlength="8"
                           placeholder="12345678"
                           required />
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <input asp-for="Email"
                           type="email"
                           placeholder="teacher@usjr.edu.ph"
                           required />
                </div>

                <div class="form-group">
                    <label>First Name</label>
                    <input asp-for="FirstName"
                           required />
                </div>

                <div class="form-group">
                    <label>Last Name</label>
                    <input asp-for="LastName"
                           required />
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input asp-for="Password"
                           type="password"
                           required />
                </div>

                <div class="form-group">
                    <label>Confirm Password</label>
                    <input asp-for="ConfirmPassword"
                           type="password"
                           required />
                </div>

            </div>

            <div class="submit-wrap">
                <button type="submit">Register Teacher</button>
            </div>

        </form>
    </div>
</div>

<style>
    .register-wrapper {
        min-height: calc(100vh - 60px);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px;
    }

    .register-card {
        width: 100%;
        max-width: 900px;
        background: white;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 10px 35px rgba(0,0,0,.08);
    }

    .register-header {
        text-align: center;
        margin-bottom: 35px;
    }

        .register-header h1 {
            margin: 0;
            color: #07362d;
            font-size: 38px;
            font-weight: 700;
        }

        .register-header p {
            margin-top: 10px;
            color: #666;
            font-size: 15px;
        }

    .register-form .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

        .form-group label {
            margin-bottom: 8px;
            font-weight: 600;
            color: #07362d;
        }

        .form-group input {
            height: 52px;
            border: 2px solid #dfe5e3;
            border-radius: 12px;
            padding: 0 16px;
            font-size: 15px;
            transition: .2s;
        }

            .form-group input:focus {
                outline: none;
                border-color: #f1c40f;
                box-shadow: 0 0 0 4px rgba(241,196,15,.18);
            }

    .submit-wrap {
        text-align: center;
        margin-top: 35px;
    }

        .submit-wrap button {
            background: #07362d;
            color: white;
            border: none;
            padding: 16px 42px;
            font-size: 16px;
            font-weight: 700;
            border-radius: 12px;
            cursor: pointer;
            transition: .2s;
        }

            .submit-wrap button:hover {
                background: #f1c40f;
                color: #07362d;
                transform: translateY(-2px);
            }

    .message-box {
        margin-bottom: 25px;
        background: #fff9db;
        color: #07362d;
        border-left: 5px solid #f1c40f;
        padding: 14px 18px;
        border-radius: 10px;
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .register-form .form-grid {
            grid-template-columns: 1fr;
        }
    }
</style>