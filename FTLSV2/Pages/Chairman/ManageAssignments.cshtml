@page "/Chairman/ManageAssignments"
@model FTLSV2.Pages.Chairman.ManageAssignmentsModel
@{
    ViewData["Title"] = "Manage Assignments";
    Layout = "_ChairmanLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/chairman.css" />
}

        <h1 class="chairman-title">Manage Assignments</h1>
        <div class="chairman-card">
            <h4>Assign courses to faculty</h4>
            <form method="post">
                <div style="display:flex;gap:12px;">
                    <select style="flex:1">
                        @foreach(var f in Model.FacultyOptions)
                        {
                            <option>@f</option>
                        }
                    </select>
                    <select style="flex:1">
                        @foreach(var c in Model.CourseOptions)
                        {
                            <option>@c</option>
                        }
                    </select>
                </div>
                <div style="margin-top:10px;">
                    <button class="btn-ghost" type="submit">Finalize Assignment</button>
                </div>
            </form>

            <hr />
            <h5>Current Assignments</h5>
            <table class="table-light">
                <thead><tr><th>Faculty</th><th>Course</th><th>Time</th><th>Room</th></tr></thead>
                <tbody>
                @foreach(var a in Model.CurrentAssignments)
                {
                    <tr>
                        <td>@a.Faculty</td>
                        <td>@a.Course</td>
                        <td>@a.Time</td>
                        <td>@a.Room</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
