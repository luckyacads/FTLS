@page "/Chairman/CourseCatalog"
@model FTLSV2.Pages.Chairman.CourseCatalogModel
@{
    ViewData["Title"] = "Course Catalog";
    Layout = "_ChairmanLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/chairman.css" />
}

        <h1 class="chairman-title">Course Catalog</h1>
        <div class="chairman-card">
            <h4>Course Catalog</h4>
            <table class="table-light">
                <thead>
                    <tr><th>Code</th><th>Title</th><th>Units</th></tr>
                </thead>
                <tbody>
                @foreach(var c in Model.CourseList)
                {
                    <tr>
                        <td>@c.Code</td>
                        <td>@c.Title</td>
                        <td>@c.Units</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
