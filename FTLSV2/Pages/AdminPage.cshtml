@page
@model FTLSV2.Pages.AdminPageModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin System Management";
}

<header>
    <h1>System Administration</h1>
    <button class="btn-primary" onclick="toggleAddUserForm()">+ Add New User</button>
</header>

<div id="addUserSection" class="card full-width" style="display: none; margin-bottom: 20px; border-left: 5px solid #07362d;">
    <h3>Create New Account</h3>
    <form method="post" asp-page-handler="AddUser">

        <div style="display: flex; gap: 15px; margin-bottom: 15px;">
            <div class="form-group" style="flex: 1;">
                <label>First Name</label>
                <input type="text" asp-for="InputFirstName" placeholder="e.g., Charle" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
            </div>
            <div class="form-group" style="flex: 1;">
                <label>Last Name</label>
                <input type="text" asp-for="InputLastName" placeholder="e.g., Darwin" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
            </div>
        </div>

        <div style="display: flex; gap: 15px; margin-bottom: 15px;">
            <div class="form-group" style="flex: 1;">
                <label>Faculty ID (8 Digits)</label>
                <input type="text" asp-for="InputFacultyId" placeholder="e.g., 87654321" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
            </div>
            <div class="form-group" style="flex: 1;">
                <label>Email Address</label>
                <input type="email" asp-for="InputEmail" placeholder="e.g., cdarwin@usjr.edu.ph" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
            </div>
        </div>

        <div style="display: flex; gap: 15px; margin-bottom: 15px;">
            <div class="form-group" style="flex: 1;">
                <label>Temporary Password</label>
                <input type="text" asp-for="InputPassword" placeholder="Assign a password" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
            </div>
            <div class="form-group" style="flex: 1;">
                <label>Role</label>
                <select asp-for="InputRole" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
                    <option value="Teacher">Teacher</option>
                    <option value="Chairman">Chairman</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
        </div>

        <div style="margin-top: 15px;">
            <button type="submit" class="btn-primary">Save User</button>
            <button type="button" class="btn-ghost" onclick="toggleAddUserForm()" style="margin-left: 10px; padding: 10px; border: none; background: #eee; cursor: pointer;">Cancel</button>
        </div>
    </form>
</div>

<div class="admin-grid">
    <section class="card full-width">
        <h3>Registered Accounts</h3>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Faculty ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.DbUsers)
                {
                    <tr>
                        <td>@user.FacultyId</td>
                        <td>@user.FirstName @user.LastName</td>
                        <td>@user.Email</td>
                        <td>@user.Role</td>

                        <td>
                            @if (user.Status == "Active" || string.IsNullOrEmpty(user.Status))
                            {
                                <span style="color: #2ecc71; font-weight: bold;">Active</span>
                            }
                            else
                            {
                                <span style="color: #e74c3c; font-weight: bold;">Inactive</span>
                            }
                        </td>

                        <td>
                            <div class="button-group" style="display: flex; gap: 5px;">

                                <form method="post" asp-page-handler="ToggleUserStatus" style="margin: 0;">
                                    <input type="hidden" name="facultyId" value="@user.FacultyId" />
                                    @if (user.Status == "Active" || string.IsNullOrEmpty(user.Status))
                                    {
                                        <button type="submit" style="background-color: #e74c3c; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer;">Deactivate</button>
                                    }
                                    else
                                    {
                                        <button type="submit" style="background-color: #2ecc71; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer;">Activate</button>
                                    }
                                </form>

                                <form method="post" asp-page-handler="ResetPassword" style="margin: 0;" onsubmit="return confirm('Are you sure you want to reset this password to usjr1234?');">
                                    <input type="hidden" name="facultyId" value="@user.FacultyId" />
                                    <button type="submit" style="background-color: #f39c12; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer;">Reset PW</button>
                                </form>

                                <form method="post" asp-page-handler="DeleteUser" style="margin: 0;" onsubmit="return confirm('WARNING: Are you sure you want to PERMANENTLY delete this account? This cannot be undone.');">
                                    <input type="hidden" name="facultyId" value="@user.FacultyId" />
                                    <button type="submit" style="background-color: #34495e; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer;">Delete</button>
                                </form>

                            </div>
                        </td>
                     
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section class="card full-width">
        <h3>Load Constraint Rules</h3>

        @if (TempData["SuccessMessage"] != null)
        {
            <div id="success-alert" style="background-color: #d4edda; color: #155724; padding: 12px; margin-bottom: 20px; border-radius: 6px; border-left: 5px solid #28a745; font-weight: 500; transition: opacity 1s ease-out; opacity: 1;">
                ✓ @TempData["SuccessMessage"]
            </div>
        }
        <form method="post" asp-page-handler="UpdateRules">
            <div class="form-group">
                <label>Regular Load Limit (Units)</label>
                <input type="number" asp-for="InputRegularLoad" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
            </div>
            <div class="form-group">
                <label>Max Overload Limit (Units)</label>
                <input type="number" asp-for="InputMaxOverload" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
            </div>
            <button type="submit" class="btn-primary">Update Rules</button>
        </form>
    </section>
</div>

<script>
    // 1. Function to show/hide the Add User form
    function toggleAddUserForm() {
        var form = document.getElementById("addUserSection");
        if (form.style.display === "none" || form.style.display === "") {
            form.style.display = "block";
        } else {
            form.style.display = "none";
        }
    }

    // 2. Function to fade out the success message
    window.onload = function() {
        var alertBox = document.getElementById("success-alert");

        // Check if the alert box actually exists on the page right now
        if (alertBox) {
            // Wait 3 seconds (3000 milliseconds) before starting the fade
            setTimeout(function() {
                alertBox.style.opacity = "0"; // Triggers the CSS transition to fade out

                // Wait 1 more second for the fade animation to finish, then completely remove the box so it doesn't leave an empty gap
                setTimeout(function() {
                    alertBox.style.display = "none";
                }, 1000);

            }, 3000);
        }
    };
</script>