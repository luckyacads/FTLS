@page
@model FTLSV2.Pages.AdminPageModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin System Management";
}

<style>
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.6); /* Dark semi-transparent background */
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal-content {
        background: white;
        padding: 25px;
        border-radius: 8px;
        width: 350px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        border-top: 5px solid #07362d; /* Matches your theme! */
    }
</style>

<header>
    <h1>System Administration</h1>
    <button class="btn-primary" onclick="toggleAddUserForm()">+ Add New User</button>
</header>

<div id="addUserSection" class="card full-width" style="display: none; margin-bottom: 20px; border-left: 5px solid #07362d;">
    <h3>Create New Account</h3>
    <form method="post" asp-page-handler="AddUser">

        <div style="display: flex; gap: 15px; margin-bottom: 15px;">
            <div class="form-group" style="flex: 1;">
                <label>First Name</label>
                <input type="text" asp-for="InputFirstName" placeholder="e.g., Charle" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
            </div>
            <div class="form-group" style="flex: 1;">
                <label>Last Name</label>
                <input type="text" asp-for="InputLastName" placeholder="e.g., Darwin" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
            </div>
        </div>

        <div style="display: flex; gap: 15px; margin-bottom: 15px;">
            <div class="form-group" style="flex: 1;">
                <label>Faculty ID (8 Digits)</label>
                <input type="text" asp-for="InputFacultyId" placeholder="e.g., 87654321" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
            </div>
            <div class="form-group" style="flex: 1;">
                <label>Email Address</label>
                <input type="email" asp-for="InputEmail" placeholder="e.g., cdarwin@usjr.edu.ph" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
            </div>
        </div>

        <div style="display: flex; gap: 15px; margin-bottom: 15px;">
            <div class="form-group" style="flex: 1;">
                <label>Temporary Password</label>
                <input type="text" asp-for="InputPassword" placeholder="Assign a password" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
            </div>
            <div class="form-group" style="flex: 1;">
                <label>Role</label>
                <select asp-for="InputRole" id="roleSelect" onchange="handleRoleChange()" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
                    <option value="Teacher">Teacher</option>
                    <option value="Chairman">Chairman</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
        </div>

        <div style="display: flex; gap: 15px; margin-bottom: 15px;">
            <div class="form-group" style="flex: 1;">
                <label>Max Allowed Units</label>
                <input type="number" asp-for="InputMaxUnits" id="maxUnitsInput" required min="1" max="@Model.InputMaxOverload" placeholder="e.g., @Model.InputMaxOverload" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
            </div>
            <div style="flex: 1;"></div>
        </div>

        <div style="margin-top: 15px;">
            <button type="submit" class="btn-primary">Save User</button>
            <button type="button" class="btn-ghost" onclick="toggleAddUserForm()" style="margin-left: 10px; padding: 10px; border: none; background: #eee; cursor: pointer;">Cancel</button>
        </div>
    </form>
</div>

<div class="admin-grid">
    <section class="card full-width">
        <h3>Registered Accounts</h3>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Faculty ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Max Units</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.DbUsers)
                {
                    <tr>
                        <td>@user.FacultyId</td>
                        <td>@user.FirstName @user.LastName</td>
                        <td>@user.Email</td>
                        <td>@user.Role</td>

                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span style="color: #7f8c8d; font-style: italic;">N/A</span>
                            }
                            else
                            {
                                <strong style="color: #07362d;">@user.MaxUnits Units</strong>
                            }
                        </td>

                        <td>
                            @if (user.Status == "Active" || string.IsNullOrEmpty(user.Status))
                            {
                                <span style="color: #2ecc71; font-weight: bold;">Active</span>
                            }
                            else
                            {
                                <span style="color: #e74c3c; font-weight: bold;">Inactive</span>
                            }
                        </td>

                        <td>
                            <div class="button-group" style="display: flex; gap: 5px;">

                                @if (user.Role != "Admin")
                                {
                                    <button type="button" onclick="openEditModal('@user.FacultyId', '@user.MaxUnits', @Model.InputMaxOverload)" style="background-color: #3498db; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer;">Edit Units</button>
                                }

                                <form method="post" asp-page-handler="ToggleUserStatus" style="margin: 0;">
                                    <input type="hidden" name="facultyId" value="@user.FacultyId" />
                                    @if (user.Status == "Active" || string.IsNullOrEmpty(user.Status))
                                    {
                                        <button type="submit" style="background-color: #e74c3c; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer;">Deactivate</button>
                                    }
                                    else
                                    {
                                        <button type="submit" style="background-color: #2ecc71; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer;">Activate</button>
                                    }
                                </form>

                                <form method="post" asp-page-handler="ResetPassword" style="margin: 0;" onsubmit="return confirm('Are you sure you want to reset this password?');">
                                    <input type="hidden" name="facultyId" value="@user.FacultyId" />
                                    <button type="submit" style="background-color: #f39c12; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer;">Reset PW</button>
                                </form>

                                <form method="post" asp-page-handler="DeleteUser" style="margin: 0;" onsubmit="return confirm('WARNING: Are you sure you want to PERMANENTLY delete this account?');">
                                    <input type="hidden" name="facultyId" value="@user.FacultyId" />
                                    <button type="submit" style="background-color: #34495e; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer;">Delete</button>
                                </form>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>

<div id="editUnitsModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
        <h3 style="margin-top: 0; color: #07362d;">Edit Max Units</h3>
        <p id="modalLimitText" style="font-size: 13px; color: #e74c3c; margin-bottom: 15px; font-weight: bold;"></p>

        <form method="post" asp-page-handler="UpdateUserUnits">
            <input type="hidden" name="facultyId" id="modalFacultyId" />
            <div class="form-group">
                <label>New Max Units</label>
                <input type="number" name="newUnits" id="modalNewUnits" required min="1" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;">
            </div>
            <div style="margin-top: 20px; display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" class="btn-ghost" onclick="closeEditModal()" style="padding: 8px 15px; border: none; background: #eee; border-radius: 4px; cursor: pointer;">Cancel</button>
                <button type="submit" class="btn-primary" style="padding: 8px 15px; background-color: #2ecc71; color: white; border: none; border-radius: 4px; cursor: pointer;">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<script>
    function toggleAddUserForm() {
        var form = document.getElementById("addUserSection");
        form.style.display = (form.style.display === "none" || form.style.display === "") ? "block" : "none";
    }

    function handleRoleChange() {
        var role = document.getElementById("roleSelect").value;
        var unitsBox = document.getElementById("maxUnitsInput");

        if (role === "Admin") {
            unitsBox.value = 0;
            unitsBox.readOnly = true;
            unitsBox.style.backgroundColor = "#e9ecef";
        } else {
            unitsBox.readOnly = false;
            unitsBox.style.backgroundColor = "white";
            if (unitsBox.value == 0) unitsBox.value = @Model.InputMaxOverload;
        }
    }

    // NEW: Open the sleek Custom Modal
    function openEditModal(facultyId, currentUnits, globalMax) {
        document.getElementById('modalFacultyId').value = facultyId;
        document.getElementById('modalNewUnits').value = currentUnits;
        document.getElementById('modalNewUnits').max = globalMax; // Prevents them from going over the limit
        document.getElementById('modalLimitText').innerText = "(Must not exceed the Global Limit of " + globalMax + " units)";

        document.getElementById('editUnitsModal').style.display = "flex";
    }

    // NEW: Close the Custom Modal
    function closeEditModal() {
        document.getElementById('editUnitsModal').style.display = "none";
    }

    window.onload = function() {
        var alertBox = document.getElementById("success-alert");
        if (alertBox) {
            setTimeout(function() {
                alertBox.style.opacity = "0";
                setTimeout(function() { alertBox.style.display = "none"; }, 1000);
            }, 3000);
        }
    };
</script>