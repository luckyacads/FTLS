@page
@model FTLSV2.Pages.AdminPageModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin System Management - FTLS</title>
    <link rel="stylesheet" href="../CSS/AdminPage.css">
</head>
<body>

    <div class="admin-container">
        <aside class="sidebar">
            <h2>Admin Control</h2>
            <nav>
                <a href="#" class="active">User Management</a>
                <a href="#">Room Registry</a>
                <a href="#">Subject Library</a>
                <a href="#">Audit Logs</a>
                <a href="/LoginPage" class="logout">Logout</a>
            </nav>
        </aside>

        <main class="main-content">
            <header>
                <h1>System Administration</h1>
                <button class="btn-primary">+ Add New User</button>
            </header>

            <div class="admin-grid">
                <section class="card full-width">
                    <h3>Registered Accounts</h3>
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Engr. Harley</td>
                                <td>Faculty</td>
                                <td><span class="status-active">Active</span></td>
                                <td>
                                    <div class="button-group">
                                        <button class="btn-toggle">Deactivate</button>
                                        <button class="btn-reset">Reset PW</button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>Engr. Lucky</td>
                                <td>Faculty</td>
                                <td><span class="status-inactive">Inactive</span></td>
                                <td>
                                    <div class="button-group">
                                        <button class="btn-toggle active">Activate</button>
                                        <button class="btn-reset">Reset PW</button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <section class="card full-width">
                    <h3>Load Constraint Rules</h3>
                    <div class="form-group">
                        <label>Regular Load Limit (Units)</label>
                        <input type="number" value="15">
                    </div>
                    <div class="form-group">
                        <label>Max Overload Limit (Units)</label>
                        <input type="number" value="21">
                    </div>
                    <button class="btn-primary">Update Rules</button>
                </section>

            </div>
        </main>
    </div>

</body>
</html>
