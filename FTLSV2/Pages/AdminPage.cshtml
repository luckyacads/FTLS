@page
@model FTLSV2.Pages.AdminPageModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin System Management";
}

<style>
/* ===== GLOBAL ===== */
body {
    background: #f5f7fa;
    font-family: 'Segoe UI', system-ui, sans-serif;
}

.container {
    max-width: 1200px;
    margin: auto;
}

/* ===== HEADER ===== */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

header h1 {
    font-size: 24px;
    font-weight: 600;
}

header p {
    font-size: 13px;
    color: #888;
}

/* ===== BUTTON ===== */
.btn-primary {
    background: #07362d;
    color: white;
    border: none;
    padding: 9px 14px;
    border-radius: 6px;
    cursor: pointer;
}

/* ===== CARD ===== */
.card {
    background: white;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 6px 18px rgba(0,0,0,0.06);
}

/* ===== FORM ===== */
.form-group {
    margin-bottom: 12px;
}

.input {
    width: 100%;
    padding: 10px;
    border-radius: 6px;
    border: 1px solid #ddd;
}

.input:focus {
    border-color: #07362d;
    outline: none;
    box-shadow: 0 0 0 2px rgba(7,54,45,0.1);
}

/* ===== ALERT ===== */
.alert {
    padding: 14px;
    border-radius: 8px;
    margin-bottom: 20px;
    background: #eafaf1;
    border-left: 6px solid #2ecc71;
}

/* ===== TABLE ===== */
.admin-table {
    width: 100%;
    border-collapse: collapse;
}

.admin-table thead {
    background: #f8f9fb;
}

.admin-table th {
    font-size: 11px;
    text-transform: uppercase;
    color: #999;
    padding: 10px;
}

.admin-table td {
    padding: 12px 10px;
}

.admin-table tr:hover {
    background: #f6f9fc;
}

/* ===== BADGES ===== */
.badge {
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
}

.green { background: #e1f5ee; color: #0f6e56; }
.red { background: #fdf0f0; color: #c0392b; }

/* ===== GRID ===== */
.grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
}
</style>

<div class="container">

<header>
    <div>
        <h1>System Administration</h1>
        <p>Manage faculty accounts and load limits</p>
    </div>
    <button class="btn-primary" onclick="toggleAddUserForm()">+ Add User</button>
</header>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert">
        ✔ @TempData["SuccessMessage"]
    </div>
}

<div id="addUserSection" class="card" style="display:none;">
    <h3>Create User</h3>
    <form method="post" asp-page-handler="AddUser">

        <div class="form-group">
            <input class="input" asp-for="InputFirstName" placeholder="First Name" required />
        </div>

        <div class="form-group">
            <input class="input" asp-for="InputLastName" placeholder="Last Name" required />
        </div>

        <div class="form-group">
            <input class="input" asp-for="InputFacultyId" placeholder="Faculty ID" required />
        </div>

        <div class="form-group">
            <input class="input" asp-for="InputEmail" placeholder="Email" required />
        </div>

        <div class="form-group">
            <input class="input" asp-for="InputPassword" placeholder="Password" required />
        </div>

        <div class="form-group">
            <select class="input" asp-for="InputRole">
                <option>Teacher</option>
                <option>Chairman</option>
                <option>Admin</option>
            </select>
        </div>

        <div class="form-group">
            <input class="input" asp-for="InputMaxUnits" type="number"
                   max="@Model.InputMaxOverload" placeholder="Max Units" />
        </div>

        <button class="btn-primary">Save</button>
    </form>
</div>

<div class="grid">

    <!-- USERS -->
    <section class="card">
        <h3>Registered Accounts (@Model.DbUsers.Count)</h3>

        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Units</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model.DbUsers)
                {
                    <tr>
                        <td>@user.FacultyId</td>
                        <td>@user.FirstName @user.LastName</td>
                        <td>@user.Role</td>

                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span>N/A</span>
                            }
                            else
                            {
                                <span class="badge green">@user.MaxUnits</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <!-- RULES -->
    <section class="card">
        <h3>Load Rules</h3>

        <form method="post" asp-page-handler="UpdateRules">
            <div class="form-group">
                <input class="input" asp-for="InputMaxOverload" type="number" />
            </div>

            <button class="btn-primary">Update</button>
        </form>
    </section>

</div>

</div>

<script>
function toggleAddUserForm() {
    var x = document.getElementById("addUserSection");
    x.style.display = x.style.display === "none" ? "block" : "none";
}
</script>