@using FTLSV2.Data
@using FTLSV2.Models
@inject FtlsDbContext _context

@{
    var userIdString = Context.Session.GetString("ActiveUser");
    User loggedUser = null;

    string departmentName = "No Department Assigned";
    string initials = "";

    if (!string.IsNullOrEmpty(userIdString) && int.TryParse(userIdString, out int userId))
    {
        loggedUser = _context.Users
            .Where(u => u.FacultyId == userId)
            .Select(u => new User
            {
                FacultyId = u.FacultyId,
                FirstName = u.FirstName,
                LastName = u.LastName,
                Email = u.Email,
                DepartmentId = u.DepartmentId
            })
            .FirstOrDefault();

        if (loggedUser != null)
        {
            departmentName = _context.Departments
                .Where(d => d.Id == loggedUser.DepartmentId)
                .Select(d => d.Name)
                .FirstOrDefault() ?? "No Department Assigned";

            var firstInitial = !string.IsNullOrEmpty(loggedUser.FirstName)
                ? loggedUser.FirstName.Substring(0, 1)
                : "";

            var lastInitial = !string.IsNullOrEmpty(loggedUser.LastName)
                ? loggedUser.LastName.Substring(0, 1)
                : "";

            initials = firstInitial + lastInitial;
        }
    }

    var path = Context.Request.Path.Value ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FTLSV2</title>
    <link rel="stylesheet" href="~/css/Teacher-Sidebar.css" />

    @RenderSection("Styles", required: false)

    <style>
            html,
            body {
                height: 100%;
                margin: 0;
            }

            .teacher-container {
                min-height: 100vh;
                display: flex;
            }

            .sidebar {
                min-height: 100vh;
                height: 100vh;
                position: sticky;
                top: 0;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            .sidebar-header {
                flex-shrink: 0;
            }

            .profile-avatar,
            .profile-info {
                flex-shrink: 0;
            }

            .sidebar-top {
                flex-shrink: 0;
                overflow: visible;
            }

            .nav-links {
                display: flex;
                flex-direction: column;
            }

                .nav-links a {
                    display: block;
                    padding: 8px 12px;
                    margin-bottom: 6px;
                    border-radius: 6px;
                    color: #ffffff;
                    text-decoration: none;
                    font-size: 14px;
                    font-weight: 500;
                    line-height: 1.2;
                    transition: all 0.2s ease;
                }

                    .nav-links a:hover,
                    .nav-links a.active {
                        background: #f1c40f !important;
                        color: #07362d !important;
                    }

                .nav-links .logout {
                    margin-top: 10px;
                }

            .profile-department {
                font-size: 13px;
                margin-top: 4px;
                color: #f1c40f;
                opacity: 0.95;
                font-weight: 500;
            }
    </style>
</head>
<body>
    <div class="teacher-container">
        <aside class="sidebar">
            <div class="sidebar-header">
                <h2>Faculty Portal</h2>
            </div>

            @if (loggedUser != null)
            {
                <div class="profile-avatar">
                    @initials
                </div>

                <div class="profile-info">
                    <div class="profile-name">
                        @loggedUser.FirstName @loggedUser.LastName
                    </div>

                    <div class="profile-id">
                        ID: @loggedUser.FacultyId
                    </div>

                    <div class="profile-email">
                        @loggedUser.Email
                    </div>

                    <div class="profile-department">
                        Department: @departmentName
                    </div>

                    <div class="profile-divider"></div>
                </div>
            }

            <div class="sidebar-top">
                <nav class="nav-links">
                    <a asp-page="/Teacher/TeacherPage"
                           class="@(path.StartsWith("/Teacher/TeacherPage", System.StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                        My Schedule
                    </a>

                    <a asp-page="/Teacher/CurriculumCatalog"
                           class="@(path.StartsWith("/Teacher/CurriculumCatalog", System.StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                        Curriculum Catalog
                    </a>

                    <a asp-page="/Teacher/AccountSettings"
                           class="@(path.StartsWith("/Teacher/AccountSettings", System.StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                        Account Settings
                    </a>

                    <a asp-page="/LoginPage" asp-page-handler="Logout" class="logout">
                        Logout
                    </a>
                </nav>
            </div>
        </aside>

        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
            window.addEventListener('pageshow', function (event) {
                if (event.persisted) {
                    window.location.reload(true);
                }
            });
    </script>
</body>
</html>