@page
@model FTLSV2.Pages.Teacher.TeacherPageModel
@{
    ViewData["Title"] = "Faculty Portal";
}

@section Styles {
    <link rel="stylesheet" href="~/css/chairman.css" />
    <link rel="stylesheet" href="~/css/MySchedule.css" />
    <style>
        /* --- 1. MODERN DASHBOARD STATS --- */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: linear-gradient(135deg, #07362d 0%, #115c4d 100%);
            color: white;
            padding: 24px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

            .stat-card h4 {
                color: #a7f3d0;
                font-size: 14px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                margin-bottom: 8px;
            }

        .stat-value {
            font-size: 32px;
            font-weight: 800;
            margin: 0;
        }

        /* --- 2. NEW: SPLIT VIEW LAYOUT --- */
        .schedule-split-view {
            display: flex;
            gap: 25px;
            align-items: flex-start;
            margin-bottom: 30px;
        }

        /* The Day Boxes (Left Side) */
        .day-sidebar {
            width: 220px;
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
            flex-shrink: 0;
        }

        .day-box {
            background: #07362d;
            color: white;
            padding: 16px 15px;
            border-radius: 10px;
            text-align: center;
            font-weight: 600;
            font-size: 15px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
            border: 2px solid transparent;
            user-select: none;
        }

            .day-box:hover {
                transform: translateY(-3px);
                box-shadow: 0 6px 12px -2px rgba(0,0,0,0.15);
                background: #0a4d40;
            }

            .day-box.active {
                background: #f1c40f;
                color: #07362d;
                border: 2px solid #07362d;
                transform: translateY(-3px);
                box-shadow: 0 6px 12px -2px rgba(0,0,0,0.15);
            }

        /* The Table Display (Right Side) */
        .schedule-content {
            flex: 1;
            background: white;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            padding: 25px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);
            min-height: 400px; /* Keeps the right side from jumping up/down */
        }

        .schedule-content-header {
            color: #111827;
            margin-top: 0;
            font-size: 20px;
            border-bottom: 2px solid #f3f4f6;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }

        /* --- 3. MODERN TABLE UI --- */
        .table-wrapper {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            overflow: hidden;
            overflow-x: auto;
        }

        .schedule-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            min-width: 600px;
        }

            .schedule-table thead {
                background: #f8f9fb;
                border-bottom: 2px solid #e5e7eb;
            }

            .schedule-table th {
                padding: 14px 20px;
                font-size: 11px;
                text-transform: uppercase;
                color: #6b7280;
                font-weight: 700;
                letter-spacing: 0.5px;
            }

            .schedule-table td {
                padding: 14px 20px;
                font-size: 13px;
                color: #374151;
                border-bottom: 1px solid #f3f4f6;
                vertical-align: middle;
            }

            .schedule-table tbody tr:last-child td {
                border-bottom: none;
            }

            .schedule-table tbody tr:hover {
                background-color: #f9fafb;
            }

        .col-time {
            font-weight: 600;
            color: #111827;
        }

        .col-code {
            font-weight: 700;
            color: #07362d;
        }

        /* Animation for changing days */
        .fade-in {
            animation: fadeIn 0.3s ease-in-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Responsive Fixes */
        @@media (max-width: 900px) {
            .schedule-split-view {
                flex-direction: column;
            }

            .day-sidebar {
                width: 100%;
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @@media (max-width: 600px) {
            .stats-row {
                grid-template-columns: 1fr;
            }

            .day-sidebar {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
}

<div class="header-bar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h1 class="chairman-title" style="color: #07362d; margin: 0;">Welcome, Engr. @Model.LoggedInUser.FirstName @Model.LoggedInUser.LastName</h1>
    <button class="btn-print" onclick="printSchedule()" style="background: #10b981; color: white; border: none; padding: 10px 18px; border-radius: 6px; font-weight: 600; cursor: pointer; box-shadow: 0 2px 4px rgba(16, 185, 129, 0.2);">Print Load</button>
</div>

<div class="stats-row">
    <div class="stat-card">
        <h4>Total Classes</h4>
        <p class="stat-value">@Model.TotalClasses</p>
    </div>
    <div class="stat-card">
        <h4>Total Units</h4>
        <p class="stat-value">@Model.TotalUnits <span style="font-size: 18px; color: #a7f3d0; font-weight: normal;">/ @Model.LoggedInUser.MaxUnits</span></p>
    </div>
    <div class="stat-card">
        <h4>Academic Year</h4>
        <p class="stat-value" style="font-size: 26px;">@Model.CurrentAcademicYear</p>
    </div>
</div>

<div class="schedule-split-view" id="printableArea">

    <div class="day-sidebar" id="printSidebar">
        <div class="day-box active" onclick="selectDay(this, 'Monday', 'MWF')">Monday</div>
        <div class="day-box" onclick="selectDay(this, 'Tuesday', 'TTH')">Tuesday</div>
        <div class="day-box" onclick="selectDay(this, 'Wednesday', 'MWF')">Wednesday</div>
        <div class="day-box" onclick="selectDay(this, 'Thursday', 'TTH')">Thursday</div>
        <div class="day-box" onclick="selectDay(this, 'Friday', 'MWF')">Friday</div>
        <div class="day-box" onclick="selectDay(this, 'Saturday', 'SAT')">Saturday</div>
    </div>

    <div class="schedule-content">
        <h3 class="schedule-content-header" id="selectedDayTitle">Monday's Schedule</h3>

        <div class="table-wrapper" id="scheduleTableWrapper">
            <table class="schedule-table">
                <thead>
                    <tr>
                        <th style="width: 25%;">Time</th>
                        <th style="width: 15%;">Code</th>
                        <th style="width: 30%;">Subject</th>
                        <th style="width: 15%;">Room</th>
                        <th style="width: 15%; text-align: center;">Units</th>
                    </tr>
                </thead>
                <tbody id="scheduleTableBody">
                    @foreach (var schedule in Model.MWFSchedules)
                    {
                        <tr class="schedule-row" data-daycode="MWF">
                            <td class="col-time">@schedule.TimeSlot</td>
                            <td class="col-code">@schedule.SubjectCode</td>
                            <td>@schedule.SubjectTitle</td>
                            <td>@schedule.RoomName</td>
                            <td style="text-align: center;">
                                <span style="background: #f3f4f6; color: #374151; padding: 4px 10px; border-radius: 6px; font-weight: 700; font-size: 12px;">@schedule.Units Units</span>
                            </td>
                        </tr>
                    }

                    @foreach (var schedule in Model.TTHSchedules)
                    {
                        <tr class="schedule-row" data-daycode="TTH" style="display: none;">
                            <td class="col-time">@schedule.TimeSlot</td>
                            <td class="col-code">@schedule.SubjectCode</td>
                            <td>@schedule.SubjectTitle</td>
                            <td>@schedule.RoomName</td>
                            <td style="text-align: center;">
                                <span style="background: #f3f4f6; color: #374151; padding: 4px 10px; border-radius: 6px; font-weight: 700; font-size: 12px;">@schedule.Units Units</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="noClassesMessage" style="display: none; text-align: center; padding: 60px 20px; color: #6b7280; background: #f9fafb; border-radius: 8px; border: 1px dashed #e5e7eb;">
            <p style="margin: 0; font-size: 15px; font-weight: 500;">No classes scheduled for this day.</p>
        </div>

    </div>
</div>

@if (Model.SubjectHistory.Any())
{
    <div class="schedule-card" style="margin-top: 10px; background: white; padding: 25px; border-radius: 12px; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #f3f4f6; padding-bottom: 15px; margin-bottom: 20px;">
            <h3 style="color: #111827; margin: 0; font-size: 20px;">Subject History</h3>

            <form method="get" style="display: flex; gap: 10px; align-items: center;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <label style="font-weight: 600; font-size: 13px; color: #4b5563;">Academic Year:</label>
                    <select asp-for="SelectedYear" onchange="this.form.submit()" style="padding: 6px 12px; border-radius: 6px; border: 1px solid #d1d5db; min-width: 150px; font-size: 13px; color: #111827; background: #f9fafb;">
                        <option value="">All Years</option>
                        @foreach (var year in Model.AvailableYears)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </div>
            </form>
        </div>

        @foreach (var historyGroup in Model.SubjectHistory)
        {
            <div class="semester-section" style="margin-bottom: 15px; border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden;">
                <div class="semester-header" onclick="toggleSemester(this)" style="background: #f1c40f; padding: 14px 20px; cursor: pointer; display: flex; justify-content: space-between; border-radius: 8px 8px 0 0;">
                    <h4 style="margin: 0; color: #07362d; font-size: 16px; font-weight: 700;">@historyGroup.HeaderName</h4>
                    <span style="color: #07362d; font-size: 14px; font-weight: bold;">▼</span>
                </div>
                <div class="semester-content" style="padding: 0;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 13px; text-align: left;">
                        <thead style="background: #ffffff; border-bottom: 2px solid #f1f5f9;">
                            <tr>
                                <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">Subject Code</th>
                                <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">Subject</th>
                                <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">Offer Code</th>
                                <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">Units</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var subject in historyGroup.Subjects)
                            {
                                <tr style="border-bottom: 1px solid #f1f5f9; background: #ffffff; transition: background 0.1s;">
                                    <td style="padding: 12px 20px; font-weight: 600; color: #0f172a;">@subject.SubjectCode</td>
                                    <td style="padding: 12px 20px; color: #334155;">@subject.SubjectTitle</td>
                                    <td style="padding: 12px 20px;">
                                        @if (subject.OfferCode.HasValue)
                                        {
                                            <span style="background: #f1f5f9; color: #475569; padding: 2px 8px; border-radius: 4px; font-weight: 600; font-size: 11px;">@subject.OfferCode</span>
                                        }
                                        else
                                        {
                                            <span style="color: #cbd5e1;">N/A</span>
                                        }
                                    </td>
                                    <td style="padding: 12px 20px; font-weight: 600; color: #0f172a;">@subject.Units</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        // --- Split-View Logic ---
        function selectDay(element, dayName, dayCode) {
            // 1. Update active styling on the boxes
            document.querySelectorAll('.day-box').forEach(box => box.classList.remove('active'));
            element.classList.add('active');

            // 2. Update the Title
            document.getElementById('selectedDayTitle').innerText = dayName + "'s Schedule";

            // 3. Filter the Table Rows
            let rows = document.querySelectorAll('.schedule-row');
            let visibleCount = 0;

            // Remove animation class to restart it
            let tableBody = document.getElementById('scheduleTableBody');
            tableBody.classList.remove('fade-in');
            void tableBody.offsetWidth; // Trigger reflow to restart animation

            rows.forEach(row => {
                if(row.getAttribute('data-daycode') === dayCode) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            // Re-add animation
            tableBody.classList.add('fade-in');

            // 4. Toggle empty state message
            if (visibleCount > 0) {
                document.getElementById('scheduleTableWrapper').style.display = 'block';
                document.getElementById('noClassesMessage').style.display = 'none';
            } else {
                document.getElementById('scheduleTableWrapper').style.display = 'none';
                document.getElementById('noClassesMessage').style.display = 'block';
            }
        }

        function toggleSemester(headerElement) {
            const content = headerElement.nextElementSibling;
            content.style.display = (content.style.display === 'none') ? 'block' : 'none';
        }

        // Updated print logic to show ALL schedules properly when printing
        function printSchedule() {
            // Temporarily show ALL rows and hide the sidebar for printing
            document.querySelectorAll('.schedule-row').forEach(row => row.style.display = '');
            document.getElementById('scheduleTableWrapper').style.display = 'block';
            document.getElementById('noClassesMessage').style.display = 'none';
            document.getElementById('selectedDayTitle').innerText = "Complete Weekly Schedule";
            document.getElementById('printSidebar').style.display = 'none';

            const printContent = document.getElementById('printableArea').innerHTML;
            const originalContent = document.body.innerHTML;
            document.body.innerHTML = printContent;

            window.print();

            // Restore original content
            document.body.innerHTML = originalContent;
            window.location.reload();
        }

        // Scroll Position Saver
        window.addEventListener("beforeunload", function () {
            sessionStorage.setItem("scrollPosition", window.scrollY);
        });

        document.addEventListener("DOMContentLoaded", function () {
            const scrollPos = sessionStorage.getItem("scrollPosition");
            if (scrollPos !== null) {
                window.scrollTo({
                    top: parseInt(scrollPos),
                    left: 0,
                    behavior: "auto"
                });
                sessionStorage.removeItem("scrollPosition");
            }

            // Run logic once on load to ensure Monday is showing correctly
            let activeBox = document.querySelector('.day-box.active');
            if(activeBox) {
                selectDay(activeBox, 'Monday', 'MWF');
            }
        });
    </script>
}