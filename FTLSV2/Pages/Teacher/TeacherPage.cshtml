@page
@model FTLSV2.Pages.Teacher.TeacherPageModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <style>

    </style>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Faculty Portal - FTLS</title>
    <style>

            /* ===== GLOBAL ===== */
            body {
                margin: 0;
                font-family: 'Segoe UI', system-ui, sans-serif;
                background: #f5f7fa;
            }

            /* ===== LAYOUT ===== */
            .teacher-container {
                display: flex;
            }

            /* ===== SIDEBAR ===== */
            .sidebar {
                width: 230px;
                height: 100vh;
                background: #07362d;
                color: white;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 20px 15px;
            }

                .sidebar h2 {
                    font-size: 18px;
                    font-weight: 600;
                    margin-bottom: 25px;
                }

            /* NAV GROUP */
            .nav-links {
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

                /* LINKS */
                .nav-links a {
                    text-decoration: none;
                    color: #dfe6e9;
                    padding: 10px 12px;
                    border-radius: 6px;
                    font-size: 14px;
                    transition: all 0.2s ease;
                }

                    /* HOVER */
                    .nav-links a:hover {
                        background: rgba(255,255,255,0.08);
                        color: white;
                    }

                    /* ACTIVE */
                    .nav-links a.active {
                        background: white;
                        color: #07362d;
                        font-weight: 600;
                    }

            /* LOGOUT */
            .sidebar-bottom {
                margin-top: 20px;
            }

            .logout {
                display: block;
                text-decoration: none;
                color: #ff7675;
                padding: 10px 12px;
                border-radius: 6px;
                font-size: 14px;
            }

                .logout:hover {
                    background: rgba(255,255,255,0.08);
                }

            /* ===== MAIN ===== */
            .main-content {
                flex: 1;
                padding: 25px;
            }

            header {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .btn-secondary {
                background: #07362d;
                color: white;
                border: none;
                padding: 9px 14px;
                border-radius: 6px;
                cursor: pointer;
            }

            /* ===== CARDS ===== */
            .card {
                background: white;
                border-radius: 12px;
                padding: 20px;
                box-shadow: 0 6px 18px rgba(0,0,0,0.06);
            }

            .teacher-grid {
                display: grid;
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .full-width {
                grid-column: 1 / -1;
            }

            /* ===== TABLE ===== */
            .schedule-table {
                width: 100%;
                border-collapse: collapse;
            }

                .schedule-table th {
                    background: #f8f9fb;
                    font-size: 11px;
                    text-transform: uppercase;
                    color: #999;
                    padding: 10px;
                }

                .schedule-table td {
                    padding: 12px 10px;
                }

                .schedule-table tr:hover {
                    background: #f6f9fc;
                }

    </style>
</head>
<body>

    <div class="teacher-container">
        <aside class="sidebar">
            <div class="sidebar-top">
                <h2>Teacher Portal</h2>

                <nav class="nav-links">
                    <a href="/Teacher/TeacherPage" class="active">My Schedule</a>
                    <a href="/Teacher/CurriculumView">Curriculum View</a>
                    <a href="/Teacher/AccountSettings">Account Settings</a>
                </nav>
            </div>

            <div class="sidebar-bottom">
                <a href="/LoginPage?handler=Logout" class="logout">Logout</a>
            </div>
        </aside>

        <main class="main-content">
            <header>
                <h1>Welcome, @Model.LoggedInUser.FirstName @Model.LoggedInUser.LastName</h1>
                <button class="btn-secondary">Download PDF Schedule</button>
            </header>

            <div class="teacher-grid">

                <section class="card stats">
                    <h3>Load Status</h3>
                    <p>Total Units: <strong>@Model.TotalUnits / @Model.LoggedInUser.MaxUnits Units</strong></p>

                    @if (!string.IsNullOrEmpty(Model.LoadStatus))
                    {
                        <p>Status: <span style="color: @Model.StatusColor; font-weight: bold;">@Model.LoadStatus</span></p>
                    }
                </section>

                <section class="card full-width">
                    <h3>My Assigned Classes (1st Semester)</h3>
                    <table class="schedule-table">
                        <thead>
                            <tr>
                                <th>Subject</th>
                                <th>Units</th>
                                <th>Schedule</th>
                                <th>Room</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.MySchedules != null && Model.MySchedules.Any())
                            {
                                @foreach (var sched in Model.MySchedules)
                                {
                                    <tr>
                                        <td>@sched.CourseTitle</td>
                                        <td>@sched.Units</td>
                                        <td>@sched.ScheduleTime</td>
                                        <td>@sched.RoomName</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" style="text-align: center; padding: 20px; color: #7f8c8d;">No classes assigned yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>

            </div>
        </main>
    </div>

</body>
</html>