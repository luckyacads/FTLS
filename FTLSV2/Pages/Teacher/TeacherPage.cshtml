@page
@model FTLSV2.Pages.Teacher.TeacherPageModel
@{
    ViewData["Title"] = "Teacher Portal";
}

<header>
    <h1>Welcome, @Model.LoggedInUser.FirstName @Model.LoggedInUser.LastName</h1>
    <button class="btn-secondary" onclick="printSchedule()">Print Faculty</button>
</header>

<div class="teacher-grid">

    <section class="card stats">
        <h3>Load Status</h3>
        <p>Total Units: <strong>@Model.TotalUnits / @Model.LoggedInUser.MaxUnits Units</strong></p>

        @if (!string.IsNullOrEmpty(Model.LoadStatus))
        {
            <p>Status: <span style="color: @Model.StatusColor; font-weight: bold;">@Model.LoadStatus</span></p>
        }
    </section>

    <section class="card full-width" id="printableArea">
        <h3>My Assigned Classes (1st Semester)</h3>
        <table class="schedule-table">
            <thead>
                <tr>
                    <th>Subject</th>
                    <th>Units</th>
                    <th>Schedule</th>
                    <th>Room</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.MySchedules != null && Model.MySchedules.Any())
                {
                    @foreach (var sched in Model.MySchedules)
                    {
                        <tr>
                            <td>@sched.CourseTitle</td>
                            <td>@sched.Units</td>
                            <td>@sched.ScheduleTime</td>
                            <td>@sched.RoomName</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 20px; color: #7f8c8d;">No classes assigned yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

</div>

@section Scripts {
    <script>
        function printSchedule() {
            const printContent = document.getElementById('printableArea').innerHTML;
            const originalContent = document.body.innerHTML;

            document.body.innerHTML = printContent;
            window.print();
            document.body.innerHTML = originalContent;
        }
    </script>
}
