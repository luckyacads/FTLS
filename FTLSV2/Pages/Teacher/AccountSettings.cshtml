@page
@model FTLSV2.Pages.Teacher.AccountSettingsModel
@{
    ViewData["Title"] = "Account Settings";
}

<header>
    <h1>Account Settings</h1>
</header>

<div class="teacher-grid two-columns">

    <!-- PROFILE DISPLAY -->
    <section class="card">
        <h3>Profile Information</h3>

        <div class="form-grid">

            <div class="form-group">
                <label>First Name</label>
                <input class="input" value="@Model.LoggedInUser.FirstName" disabled />
            </div>

            <div class="form-group">
                <label>Last Name</label>
                <input class="input" value="@Model.LoggedInUser.LastName" disabled />
            </div>

            <div class="form-group full">
                <label>Email</label>
                <input class="input" value="@Model.LoggedInUser.Email" disabled />
            </div>

            <div class="form-group full">
                <label>Faculty ID</label>
                <input class="input" value="@Model.LoggedInUser.FacultyId" disabled />
            </div>

        </div>
    </section>

    <!-- CHANGE PASSWORD -->
    <section class="card">
        <h3>Change Password</h3>

        <form method="post" asp-page-handler="ChangePassword">

            <div class="form-grid">

                <div class="form-group full">
                    <label>Current Password</label>
                    <input type="password" class="input" asp-for="CurrentPassword" required />
                </div>

                <div class="form-group full">
                    <label>New Password</label>
                    <input type="password" class="input" asp-for="NewPassword" required />
                </div>

            </div>

            <button class="btn-primary">Update Password</button>

        </form>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert error">@Model.ErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert success">@Model.SuccessMessage</div>
        }

    </section>

</div>