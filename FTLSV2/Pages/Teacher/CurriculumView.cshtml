@page
@model FTLSV2.Pages.Teacher.CurriculumViewModel
@{
    ViewData["Title"] = "Curriculum View";
}

<header>
    <h1>Curriculum Overview</h1>
</header>

<div class="teacher-grid">

    <section class="card full-width">
        <h3>Curriculum Subjects</h3>
        <table class="curriculum-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Subject</th>
                    <th>Units</th>
                    <th>Department</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.MySubjects != null && Model.MySubjects.Any())
                {
                    @foreach (var subject in Model.MySubjects)
                    {
                        <tr class="subject-row" data-semester="@subject.Semester">
                            <td>@subject.Code</td>
                            <td>@subject.Title</td>
                            <td>@subject.Units</td>
                            <td>@subject.Department</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 20px; color: #7f8c8d;">
                            No subjects assigned yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section class="card">
        <h3>Filter</h3>
        <div class="filter-group">
            <label>Year / Semester</label>
            <select id="semesterFilter" onchange="filterSubjects()">
                <option value="All">All Semesters</option>
                <option value="1st Year - 1st Sem">1st Year - 1st Sem</option>
                <option value="1st Year - 2nd Sem">1st Year - 2nd Sem</option>
                <option value="2nd Year - 1st Sem">2nd Year - 1st Sem</option>
                <option value="2nd Year - 2nd Sem">2nd Year - 2nd Sem</option>
                <option value="3rd Year - 1st Sem">3rd Year - 1st Sem</option>
                <option value="3rd Year - 2nd Sem">3rd Year - 2nd Sem</option>
                <option value="4th Year - 1st Sem">4th Year - 1st Sem</option>
                <option value="4th Year - 2nd Sem">4th Year - 2nd Sem</option>
            </select>
        </div>
    </section>

</div>

@section Scripts {
    <script>
        function filterSubjects() {
            var selectedSemester = document.getElementById("semesterFilter").value;
            var rows = document.querySelectorAll(".subject-row");

            rows.forEach(row => {
                var rowSemester = row.getAttribute("data-semester");

                if (selectedSemester === "All" || rowSemester === selectedSemester) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }
    </script>
}