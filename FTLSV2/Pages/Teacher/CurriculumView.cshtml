@page
@model FTLSV2.Pages.Teacher.CurriculumViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Curriculum View - FTLS</title>
    <style>

            /* ===== GLOBAL ===== */
            body {
                margin: 0;
                font-family: 'Segoe UI', system-ui, sans-serif;
                background: #f5f7fa;
            }

            /* ===== LAYOUT ===== */
            .teacher-container {
                display: flex;
            }

            /* ===== SIDEBAR ===== */
            .sidebar {
                width: 230px;
                height: 100vh;
                background: #07362d;
                color: white;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 20px 15px;
            }

                .sidebar h2 {
                    font-size: 18px;
                    font-weight: 600;
                    margin-bottom: 25px;
                }

            /* NAV GROUP */
            .nav-links {
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

                /* LINKS */
                .nav-links a {
                    text-decoration: none;
                    color: #dfe6e9;
                    padding: 10px 12px;
                    border-radius: 6px;
                    font-size: 14px;
                    transition: all 0.2s ease;
                }

                    /* HOVER */
                    .nav-links a:hover {
                        background: rgba(255,255,255,0.08);
                        color: white;
                    }

                    /* ACTIVE */
                    .nav-links a.active {
                        background: white;
                        color: #07362d;
                        font-weight: 600;
                    }

            /* LOGOUT */
            .sidebar-bottom {
                margin-top: 20px;
            }

            .logout {
                display: block;
                text-decoration: none;
                color: #ff7675;
                padding: 10px 12px;
                border-radius: 6px;
                font-size: 14px;
            }

                .logout:hover {
                    background: rgba(255,255,255,0.08);
                }

            /* ===== MAIN ===== */
            .main-content {
                flex: 1;
                padding: 25px;
            }

            header {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .btn-secondary {
                background: #07362d;
                color: white;
                border: none;
                padding: 9px 14px;
                border-radius: 6px;
                cursor: pointer;
            }

            /* ===== CARDS ===== */
            .card {
                background: white;
                border-radius: 12px;
                padding: 20px;
                box-shadow: 0 6px 18px rgba(0,0,0,0.06);
            }

            .teacher-grid {
                display: grid;
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .full-width {
                grid-column: 1 / -1;
            }

            /* ===== TABLE ===== */
            .schedule-table {
                width: 100%;
                border-collapse: collapse;
            }

                .schedule-table th {
                    background: #f8f9fb;
                    font-size: 11px;
                    text-transform: uppercase;
                    color: #999;
                    padding: 10px;
                }

                .schedule-table td {
                    padding: 12px 10px;
                }

                .schedule-table tr:hover {
                    background: #f6f9fc;
                }

    </style>
</head>


<body>

    <div class="teacher-container">
        <aside class="sidebar">
            <div class="sidebar-top">
                <h2>Teacher Portal</h2>

                <nav class="nav-links">
                    <a href="/Teacher/TeacherPage">My Schedule</a>
                    <a href="/Teacher/CurriculumView" class="active">Curriculum View</a>
                    <a href="/Teacher/AccountSettings">Account Settings</a>
                </nav>
            </div>

            <div class="sidebar-bottom">
                <a href="/LoginPage?handler=Logout" class="logout">Logout</a>
            </div>
        </aside>

        <main class="main-content">
            <header>
                <h1>Curriculum Overview</h1>
            </header>

            <div class="teacher-grid">
                <section class="card full-width">
                    <h3>Curriculum Subjects</h3>
                    <table class="curriculum-table">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Subject</th>
                                <th>Units</th>
                                <th>Department</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.MySubjects != null && Model.MySubjects.Any())
                            {
                                @foreach (var subject in Model.MySubjects)
                                {
                                    <tr class="subject-row" data-semester="@subject.Semester">
                                        <td>@subject.Code</td>
                                        <td>@subject.Title</td>
                                        <td>@subject.Units</td>
                                        <td>@subject.Department</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" style="text-align: center; padding: 20px; color: #7f8c8d;">No subjects assigned yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>

                <section class="card">
                    <h3>Filter</h3>
                    <div class="filter-group">
                        <label>Year / Semester</label>
                        <select id="semesterFilter" onchange="filterSubjects()">
                            <option value="All">All Semesters</option>
                            <option value="1st Year - 1st Sem">1st Year - 1st Sem</option>
                            <option value="1st Year - 2nd Sem">1st Year - 2nd Sem</option>
                            <option value="2nd Year - 1st Sem">2nd Year - 1st Sem</option>
                            <option value="2nd Year - 2nd Sem">2nd Year - 2nd Sem</option>
                            <option value="3rd Year - 1st Sem">3rd Year - 1st Sem</option>
                            <option value="3rd Year - 2nd Sem">3rd Year - 2nd Sem</option>
                            <option value="4th Year - 1st Sem">4th Year - 1st Sem</option>
                            <option value="4th Year - 2nd Sem">4th Year - 2nd Sem</option>
                        </select>
                    </div>
                </section>
            </div>
        </main>
    </div>

    <script>
        function filterSubjects() {
            var selectedSemester = document.getElementById("semesterFilter").value;
            var rows = document.querySelectorAll(".subject-row");

            rows.forEach(row => {
                var rowSemester = row.getAttribute("data-semester");

                if (selectedSemester === "All" || rowSemester === selectedSemester) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }
    </script>
</body>
</html>