@page
@model FTLSV2.Pages.Teacher.CurriculumCatalogModel
@{
    ViewData["Title"] = "Curriculum Catalog";
}
<style>
    .curriculum-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-right: 6px;
        white-space: nowrap;
    }

    .badge-year {
        background-color: #f1f3f5;
        /* Light professional gray */
        color: #495057;
        /* Dark gray text */
        border: 1px solid #dee2e6;
    }

    .badge-sem {
        background-color: #eafbf1;
        /* Soft green */
        color: #07362d;
        /* Your theme's dark green */
        border: 1px solid #c8e6c9;
    }

    .badge-curr-year {
        background-color: #e8f4fd;
        /* Soft blue */
        color: #1d4ed8;
        /* Blue text */
        border: 1px solid #bfdbfe;
    }

    .badge-container {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
    }

</style>

<header>
    <h1>Curriculum Catalog</h1>
</header>

<section class="card" style="margin-bottom: 20px;">
    <h3 style="margin-bottom: 15px; margin-top: 0; color: #07362d;">Filter Curriculum</h3>

    <div style="display: flex; flex-direction: row; gap: 20px; align-items: flex-end; flex-wrap: wrap;">

        <div class="form-group" style="flex: 1; min-width: 200px;">
            <label style="font-weight: bold; font-size: 12px; color: #7f8c8d; text-transform: uppercase; margin-bottom: 5px; display: block;">School</label>
            <select id="schoolFilter" onchange="filterSubjects()" style="width: 100%; height: 40px; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">

                <option value="All">All Schools</option>
                @if (Model.AllSchools != null)
                {
                    @foreach (var school in Model.AllSchools)
                    {

                        var isSelected = school.Name == Model.LoggedInUser.School?.Name;
                        <option value="@school.Name" selected="@(isSelected ? "selected" : null)">@school.Name</option>
                    }
                }
            </select>
        </div>

        <div class="form-group" style="flex: 1; min-width: 200px;">
            <label style="font-weight: bold; font-size: 12px; color: #7f8c8d; text-transform: uppercase; margin-bottom: 5px; display: block;">Department</label>

            <select id="departmentFilter" onchange="filterSubjects()" style="width: 100%; height: 40px; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                <option value="All">All Departments</option>
                @if (Model.AllDepartments != null)
                {
                    @foreach (var dept in Model.AllDepartments)
                    {
                        var isSelected = dept.Name == Model.LoggedInUser.Department?.Name;
                        <option value="@dept.Name" selected="@(isSelected ? "selected" : null)">@dept.Name</option>
                    }
                }
            </select>
        </div>

        <div class="form-group" style="flex: 1; min-width: 150px;">
            <label style="font-weight: bold; font-size: 12px; color: #7f8c8d; text-transform: uppercase; margin-bottom: 5px; display: block;">Curriculum Year</label>
            <select id="curriculumYearFilter" onchange="filterSubjects()" style="width: 100%; height: 40px; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                <option value="2023">2023</option>
                <option value="2025">2025</option>
                <option value="2027">2027</option>
            </select>
        </div>

   
        <div class="form-group" style="flex: 1; min-width: 150px;">
            <label style="font-weight: bold; font-size: 12px; color: #7f8c8d; text-transform: uppercase; margin-bottom: 5px; display: block;">Year Level</label>
            <select id="yearFilter" onchange="filterSubjects()" style="width: 100%; height: 40px; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                <option value="All">All Years</option>
                <option value="1st Year">1st Year</option>
                <option value="2nd Year">2nd Year</option>
                <option value="3rd Year">3rd Year</option>

                <option value="4th Year">4th Year</option>
            </select>
        </div>

        <div class="form-group" style="flex: 1; min-width: 150px;">
            <label style="font-weight: bold; font-size: 12px; color: #7f8c8d; text-transform: uppercase; margin-bottom: 5px; display: block;">Semester</label>
            <select id="semFilter" onchange="filterSubjects()" style="width: 100%; height: 40px; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                <option value="All">All Semesters</option>
                <option value="1st Sem">1st Semester</option>
                <option value="2nd Sem">2nd Semester</option>
                <option value="Summer">Summer</option>
            </select>

        </div>

        <div>
            <button class="btn-ghost" onclick="resetFilters()" style="height: 40px; padding: 0 20px; border: 1px solid #ccc; background: #f8f9fa; border-radius: 4px; cursor: pointer; font-weight: bold; color: #07362d;">Reset Filters</button>
        </div>

    </div>
</section>

<section class="card full-width">
    <h3>Curriculum Subjects</h3>
    <table class="curriculum-table">
        <thead>
            <tr>
                <th>Code</th>
                <th>Subject</th>
                <th>Units</th>

                <th>Year & Semester</th>
                <th>Department</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.MySubjects != null && Model.MySubjects.Any())
            {
                // Pre-calculates the initial total units for each Curriculum grouping directly using the integer values
                var groupUnitsMap = Model.MySubjects
                    .GroupBy(item => $"{item.CurriculumYear}_{item.YearLevel?.Replace(" ", "")}_{item.Semester?.Replace(" ", "")}")
                    .ToDictionary(
                        g => g.Key,
                        g => g.Sum(item => item.Subject?.Units ?? 0)
                    );

                string lastGroupKey = null;
                @foreach (var item in Model.MySubjects)
                {
                    // Safely looks up the School Name based on the Department's School ID
                    var rowSchoolName = Model.AllSchools?.FirstOrDefault(s => s.Id == item.Department?.SchoolId)?.Name ?? "";

                    // COMBINED YEAR AND SEMESTER FOR THE FILTER
                    var yearAndSem = $"{item.YearLevel} {item.Semester}";
                    var yearLevelClean = item.YearLevel?.Replace(" ", "") ?? "";
                    var semesterClean = item.Semester?.Replace(" ", "") ?? "";
                    var currentGroupKey = $"{item.CurriculumYear}_{yearLevelClean}_{semesterClean}";
                    @if (lastGroupKey != currentGroupKey)
                    {
                        lastGroupKey = currentGroupKey;
                        var initialGroupUnits = groupUnitsMap.ContainsKey(currentGroupKey) ? groupUnitsMap[currentGroupKey] : 0;

                        <tr class="group-header-row" id="header-@currentGroupKey" data-group-key="@currentGroupKey">
                            <td colspan="5" style="background-color: #eafbf1; color: #07362d; font-weight: bold; padding: 12px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #c8e6c9;">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <span>@item.CurriculumYear Curriculum — @item.YearLevel — @item.Semester</span>
                                    <span style="background-color: #07362d; color: #ffffff; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: bold;">
                                        Total Units: <span class="group-total-units">@initialGroupUnits</span>
                                    </span>
                                </div>
                            </td>
                        </tr>
                    }

                    <tr class="subject-row"
                        data-semester="@yearAndSem"
                        data-department="@item.Department?.Name"
                        data-school="@rowSchoolName"
                        data-curriculum-year="@item.CurriculumYear"
                        data-units="@(item.Subject?.Units ?? 0)"
                        data-group="header-@currentGroupKey">

 
                        <td style="font-weight: bold; color: #07362d;">@item.Subject?.Code</td>
                        <td>@item.Subject?.Title</td>
                        <td>@item.Subject?.Units</td>

                        <td>

                            <div class="badge-container">
                                @if (!string.IsNullOrEmpty(item.YearLevel))
                                {

                                    <span class="curriculum-badge badge-year">@item.YearLevel</span>
                                }

                                @if (!string.IsNullOrEmpty(item.Semester))

                                {
                                    <span class="curriculum-badge badge-sem">@item.Semester</span>
                                }

  
                                @if (!string.IsNullOrEmpty(item.CurriculumYear))
                                {
                                    <span class="curriculum-badge badge-curr-year">@item.CurriculumYear</span>
                                }
                            </div>
                        </td>

               
                        <td style="color: #7f8c8d; white-space: nowrap;">@item.Department?.Name</td>
                    </tr>
                }
            }
            else
            {
                <tr>

                    <td colspan="5" style="text-align: center; padding: 20px; color: #7f8c8d;">
                        No curriculum subjects found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>

@section Scripts {
    <script>

        function filterSubjects() {
            var selectedSchool = document.getElementById("schoolFilter").value;
            var selectedDepartment = document.getElementById("departmentFilter").value;
            var selectedYear = document.getElementById("yearFilter").value;
            var selectedSem = document.getElementById("semFilter").value;
            var selectedCurriculumYear = document.getElementById("curriculumYearFilter").value;

 
            var rows = document.querySelectorAll(".subject-row");

            rows.forEach(row => {
                var rowSemester = row.getAttribute("data-semester") || "";
                var rowDepartment = row.getAttribute("data-department") || "";
                var rowSchool = row.getAttribute("data-school") || "";
                var rowCurriculumYear = row.getAttribute("data-curriculum-year") || "";

                var matchSchool = (selectedSchool === "All" || rowSchool === selectedSchool);
                var matchDepartment = (selectedDepartment === "All" || rowDepartment.includes(selectedDepartment));
                var matchYear = (selectedYear === "All" || rowSemester.includes(selectedYear));
                var matchSem = (selectedSem === "All" || rowSemester.includes(selectedSem));
                var matchCurriculumYear = (selectedCurriculumYear === "All" || rowCurriculumYear === selectedCurriculumYear);
                if (matchSchool && matchDepartment && matchYear && matchSem && matchCurriculumYear) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });

            // Filter header rows and dynamically update displayed unit totals
            var headers = document.querySelectorAll(".group-header-row");
            headers.forEach(header => {
                var id = header.id;
                var runningUnitCount = 0;
                var hasVisibleSubject = false;
                var relatedRows = document.querySelectorAll(`.subject-row[data-group="${id}"]`);

                relatedRows.forEach(r => {
                    if (r.style.display !== "none") {
                        hasVisibleSubject = true;
                        var rowUnits = parseInt(r.getAttribute("data-units")) || 0;
                        runningUnitCount += rowUnits;
                    }
                });

                // Update total units count in UI
                var totalBadgeText = header.querySelector(".group-total-units");
                if (totalBadgeText) {
                    totalBadgeText.textContent = runningUnitCount;
                }

                if (hasVisibleSubject) {
                     header.style.display = "";
                } else {
                    header.style.display = "none";
                }
            });
        }

        function resetFilters() {
            document.getElementById("schoolFilter").value = "All";
            document.getElementById("departmentFilter").value = "All";
            document.getElementById("yearFilter").value = "All";
            document.getElementById("semFilter").value = "All";
            document.getElementById("curriculumYearFilter").value = "2023";
            filterSubjects();
        }

        window.addEventListener("DOMContentLoaded", function () {
            filterSubjects();
        });
    </script>
}