<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chairman Portal</title>

    <link rel="stylesheet" href="~/CSS/TeacherPage.css" />
    <link rel="stylesheet" href="~/css/chairman.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="teacher-container">

        <aside class="sidebar">
            <h2>CHAIRMAN PORTAL</h2>
            <nav>
                <a href="/ChairmanPage">Dashboard Overview</a>
                <a href="/Chairman/FacultyProfiles">Faculty Profiles</a>
                <a href="/Chairman/CourseCatalog">Course Catalog</a>
                <a href="/Chairman/RoomUtilization">Room Utilization</a>

                <a href="/LoginPage?handler=Logout" class="logout" style="margin-top: auto;">Logout</a>
            </nav>
        </aside>

        <main class="main-content">

            @RenderBody()

        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>