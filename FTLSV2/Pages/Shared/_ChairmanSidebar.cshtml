@{
    var path = Context.Request.Path.ToString().ToLowerInvariant();
    string active(string p) => path.Contains(p.ToLowerInvariant()) ? "active" : string.Empty;
}

<aside class="chairman-sidebar" style="position: relative;">
    <div class="sidebar-top">
        <h2>CHAIRMAN PORTAL</h2>
        <div class="divider"></div>
        <nav class="chairman-nav">
            <a asp-page="/Chairman/DashboardOverview" class="@active("/chairman/dashboardoverview")">Dashboard Overview</a>
            <a asp-page="/Chairman/FacultyProfiles" class="@active("/chairman/facultyprofiles")">Faculty Profiles</a>
            <a asp-page="/Chairman/SubjectLibrary" class="@active("/chairman/subjectlibrary")">Subject Library</a>
            <a asp-page="/Chairman/CourseCatalog" class="@active("/chairman/coursecatalog")">Course Catalog</a>
            <a asp-page="/Chairman/ManageAssignments" class="@active("/chairman/manageassignments")">Manage Assignments</a>
            <a asp-page="/Chairman/RoomUtilization" class="@active("/chairman/roomutilization")">Room Utilization</a>
            <a asp-page="/Chairman/MySchedule" class="@active("/chairman/myschedule")">My Schedule</a>
            <a asp-page="/Chairman/DepartmentReports" class="@active("/chairman/departmentreports")">Department Reports</a>
        </nav>
    </div>

    <div class="logout" style="position: absolute; bottom: 30px; left: 0; width: 100%; display: flex; justify-content: center;">
        <a class="btn-ghost" asp-page="/LoginPage" style="width: 80%; text-align: center; display: block; padding: 10px 0;">Log out</a>
    </div>
</aside>