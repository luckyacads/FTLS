@using FTLSV2.Data
@using FTLSV2.Models
@inject FtlsDbContext _context
@{
    var userId = Context.Session.GetString("ActiveUser");
    User loggedUser = null;

    if (!string.IsNullOrEmpty(userId))
    {
        loggedUser = _context.Users.FirstOrDefault(u => u.FacultyId == userId);
    }
}

@* @{
    var test = Context.Session.GetString("UserId");
}
<div style="color:red;">DEBUG: @test</div> --> *@

<!DOCTYPE html>
<html lang="en">

    <style>

        /* SIDEBAR NAV STYLE */
        .sidebar nav a {
            display: block;
            padding: 8px 12px;
            border-radius: 6px;
            color: #ffffff;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            font-family: 'Segoe UI', 'Inter', system-ui, sans-serif;
            line-height: 1.2;
            transition: all 0.2s ease;
        }

        /* spacing between items */
        .sidebar nav a:not(:last-child) {
            margin-bottom: 4px; /* tighter than before */
        }

        /* HOVER + ACTIVE */
        .sidebar nav a:hover,
        .sidebar nav a.active {
            background: #f1c40f !important;
            color: #07362d !important;
        }
    </style>


<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FTLSV2</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FTLSV2.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AdminPage.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    @* Show top header only on non-admin pages *@
    @if (!(Context.Request.Path.StartsWithSegments("/Admin", System.StringComparison.OrdinalIgnoreCase)
           || Context.Request.Path.StartsWithSegments("/Admin/RoomRegistry", System.StringComparison.OrdinalIgnoreCase)
           || Context.Request.Path.StartsWithSegments("/Admin/AuditLogs", System.StringComparison.OrdinalIgnoreCase)))
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container">
                    <a class="navbar-brand" asp-area="" asp-page="/Index">FTLSV2</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }

    @* Show admin sidebar/layout only on admin pages *@
    @if (Context.Request.Path.StartsWithSegments("/Admin", System.StringComparison.OrdinalIgnoreCase))
    {
        <div class="admin-container">
            <aside class="sidebar">
                <!-- CYAN HEADER -->
                <div style="
                    padding:16px 12px;
                    text-align:center;
                    background: rgba(255,255,255,0.08);
                    border-bottom: 1px solid rgba(255,255,255,0.1);
                    ">
                    <h2 style="
                        margin:0;
                        font-size:18px;
                        font-weight:600;
                        color:#ffffff;
                        letter-spacing:0.5px;
                        ">
                        Administrator
                    </h2>
                </div>
                @if (loggedUser != null)
                {
                    <div style="
                        width:70px;
                        height:70px;
                        border-radius:50%;
                        background:#f1c40f;          /* changed to yellow */
                        color:#07362d;               /* keep dark green text */
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        font-weight:700;
                        font-size:22px;
                        margin: 15px auto 10px auto;
                        ">
                        @loggedUser.FirstName[0]@loggedUser.LastName[0]
                    </div>

                    <div style="
                        text-align:center;
                        margin-bottom: 25px;
                        color:#f1c40f;               /* changed to yellow */
                        ">

                        <div style="
                            font-size:18px;
                            font-weight:600;
                            line-height:1.2;
                            ">
                            @loggedUser.FirstName @loggedUser.LastName
                        </div>

                        <div style="
                            font-size:15px;
                            margin-top:6px;
                            font-weight:500;
                            ">
                            ID: @loggedUser.FacultyId
                        </div>

                        <div style="
                            font-size:14px;
                            margin-top:4px;
                            opacity:0.9;
                            ">
                            @loggedUser.Email
                        </div>

                        <div style="
                        height:1px;
                        width:80%;
                        margin: 10px auto 20px auto;
                        background: rgba(255,255,255,0.15);
                        "></div>

                    </div>
                }
                <nav style="
                    display:flex;
                    flex-direction:column;
                    ">
                    <a asp-page="/Admin/AdminPage" class="@(Context.Request.Path.StartsWithSegments("/Admin/AdminPage", System.StringComparison.OrdinalIgnoreCase) ? "active" : "")">User Management</a>
                    <a asp-page="/Admin/RoomRegistry" class="@(Context.Request.Path.StartsWithSegments("/Admin/RoomRegistry", System.StringComparison.OrdinalIgnoreCase) ? "active" : "")">Room Registry</a>
                    <a asp-page="/Admin/AuditLogs" class="@(Context.Request.Path.StartsWithSegments("/Admin/AuditLogs", System.StringComparison.OrdinalIgnoreCase) ? "active" : "")">Audit Logs</a>
                    <a asp-page="/LoginPage" class="logout" style="margin-top: 10px;">
                        Logout
                    </a>
                </nav>
            </aside>

            <main class="main-content">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="footer text-muted">
        <div class="container">
            &copy; 2026 - FTLSV2 - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // If the browser loads this page from the Back-Forward Cache (bfcache)
        window.addEventListener('pageshow', function (event) {
            if (event.persisted) {
                // Force a hard reload so the C# Server can kick them out!
                window.location.reload(true);
            }
        });
    </script>

</body>
</html>
