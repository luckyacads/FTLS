@page
@model FTLSV2.Pages.Admin.AuditLogsModel
@{
    Layout = "_AdminSidebar";
    ViewData["Title"] = "Audit Logs";
}

@section Styles {
    <link rel="stylesheet" href="~/css/AuditLogs.css" />
}

<div class="page-container">
    <header class="page-header">
        <h1>Audit Logs</h1>
    </header>

    <section class="card">
        <h3>Recent Activity</h3>
        <table class="logs-table">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>User</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in AuditLogsModel.Logs)
                {
                    <tr>
                        <td>@log.Timestamp</td>
                        <td>@log.Username</td>
                        <td>@log.Action</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>