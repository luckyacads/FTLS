@page
@model FTLSV2.Pages.Admin.AuditLogsModel
@{
    Layout = "_AdminSidebar";
    ViewData["Title"] = "Audit Logs";
}

@section Styles {
    <link rel="stylesheet" href="~/css/AuditLogs.css" />
}

<div class="page-container">
    <header class="page-header">
        <h1>Audit Logs</h1>
    </header>

    <section class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
            <h3>Recent Activity</h3>
        </div>
        <table class="logs-table">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>User</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Logs != null && Model.Logs.Count > 0)
                {
                    @foreach (var log in Model.Logs)
                    {
                        <tr>
                            <td>@log.Timestamp</td>
                            <td>@log.Username</td>
                            <td>@log.Action</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" style="text-align: center; padding: 20px;">No audit logs found</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>
