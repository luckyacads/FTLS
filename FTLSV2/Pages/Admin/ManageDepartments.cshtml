@page
@model FTLSV2.Pages.Admin.ManageDepartmentsModel
@{
    Layout = "/Pages/Admin/_AdminSidebar.cshtml";
    ViewData["Title"] = "Manage Departments";
}

<style>
    body {
        background: #f5f7fa;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .container {
        padding: 20px 40px;
        width: 100%;
        max-width: 100% !important;
        margin: 0 !important;
        box-sizing: border-box;
    }

    .page-header {
        margin-bottom: 25px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 26px;
            font-weight: 700;
            color: #07362d;
        }

        .page-header p {
            margin-top: 6px;
            font-size: 14px;
            color: #777;
        }

    .card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.06);
        margin-bottom: 25px;
    }

    .form-title {
        margin-top: 0;
        margin-bottom: 18px;
        font-size: 18px;
        color: #07362d;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-size: 13px;
            font-weight: 600;
            color: #555;
        }

    .input {
        width: 100%;
        padding: 10px 12px;
        border-radius: 7px;
        border: 1px solid #dcdcdc;
        box-sizing: border-box;
        font-size: 14px;
    }

        .input:focus {
            border-color: #07362d;
            outline: none;
            box-shadow: 0 0 0 2px rgba(7,54,45,0.12);
        }

    .btn-primary {
        background: #07362d;
        color: white;
        border: none;
        padding: 10px 15px;
        border-radius: 7px;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease-in-out;
    }

        .btn-primary:hover {
            background: #0a4d40;
            transform: translateY(-1px);
        }

    .btn-cancel {
        background: #f3f4f6;
        color: #374151;
        border: none;
        padding: 10px 15px;
        border-radius: 7px;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease-in-out;
    }

        .btn-cancel:hover {
            background: #e5e7eb;
            transform: translateY(-1px);
        }

    .btn-add {
        background: #07362d;
        color: white;
        border: none;
        padding: 10px 16px;
        border-radius: 7px;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease-in-out;
        white-space: nowrap;
    }

        .btn-add:hover {
            background: #0a4d40;
            transform: translateY(-1px);
        }

    .alert {
        padding: 14px;
        border-radius: 8px;
        margin-bottom: 20px;
        background: #eafaf1;
        border-left: 6px solid #2ecc71;
        color: #155724;
        font-weight: 500;
    }

    .alert-error {
        padding: 14px;
        border-radius: 8px;
        margin-bottom: 20px;
        background: #fdecea;
        border-left: 6px solid #e74c3c;
        color: #c0392b;
        font-weight: 500;
    }

    .department-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 18px;
    }

        .department-toolbar h3 {
            margin: 0;
            font-size: 18px;
            color: #07362d;
        }

    .department-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .department-search {
        width: 300px;
        padding: 10px 12px;
        border: 1px solid #dcdcdc;
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        transition: all 0.2s ease-in-out;
    }

        .department-search:focus {
            border-color: #07362d;
            box-shadow: 0 0 0 2px rgba(7,54,45,0.12);
        }

    .department-table {
        width: 100%;
        border-collapse: collapse;
    }

        .department-table thead {
            background: #f8f9fb;
        }

        .department-table th {
            font-size: 11px;
            text-transform: uppercase;
            color: #888;
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #eeeeee;
        }

        .department-table td {
            padding: 13px 12px;
            border-bottom: 1px solid #eeeeee;
            font-size: 14px;
        }

        .department-table tr:hover {
            background: #f6f9fc;
        }

    .code-badge {
        display: inline-block;
        background: #e1f5ee;
        color: #0f6e56;
        padding: 5px 9px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 700;
    }

    .no-results-row {
        display: none;
        text-align: center;
        color: #888;
        font-style: italic;
    }

    .form-actions {
        margin-top: 8px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(2px);
    }

    .modal-card {
        width: 520px;
        max-width: 92%;
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 20px 35px rgba(0, 0, 0, 0.18);
        animation: modalFadeIn 0.18s ease-out;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

        .modal-header h3 {
            margin: 0;
            font-size: 20px;
            font-weight: 700;
            color: #07362d;
        }

    .modal-close {
        border: none;
        background: transparent;
        font-size: 24px;
        line-height: 1;
        cursor: pointer;
        color: #777;
    }

        .modal-close:hover {
            color: #07362d;
        }

    @@keyframes modalFadeIn {
        from {
            opacity: 0;
            transform: translateY(-8px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
</style>

<div class="container">
    <div class="page-header">
        <h1>Manage Departments</h1>
        <p>Add, view, and search department records by code, name, or school.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert">✔ @TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-error">✖ @TempData["ErrorMessage"]</div>
    }

    <div id="addDepartmentModal" class="modal-overlay">
        <div class="modal-card">
            <div class="modal-header">
                <h3>Add New Department</h3>
                <button type="button" class="modal-close" onclick="closeAddDepartmentModal()">×</button>
            </div>

            <form method="post" asp-page-handler="AddDepartment">
                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="NewSchoolId">School</label>
                        <select asp-for="NewSchoolId" class="input" required>
                            <option value="">Select School</option>
                            @foreach (var school in Model.Schools)
                            {
                                <option value="@school.Id">@school.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label asp-for="NewCode">Department Code</label>
                        <input asp-for="NewCode"
                               class="input"
                               placeholder="Example: CPE"
                               maxlength="20"
                               required />
                    </div>

                    <div class="form-group" style="grid-column: span 2;">
                        <label asp-for="NewName">Department Name</label>
                        <input asp-for="NewName"
                               class="input"
                               placeholder="Example: Computer Engineering"
                               maxlength="150"
                               required />
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-cancel" onclick="closeAddDepartmentModal()">
                        Cancel
                    </button>

                    <button type="submit" class="btn-primary">
                        Save Department
                    </button>
                </div>
            </form>
        </div>
    </div>

    <section class="card">
        <div class="department-toolbar">
            <h3>Department List (@Model.Departments.Count)</h3>

            <div class="department-actions">
                <input type="text"
                       id="departmentSearch"
                       class="department-search"
                       placeholder="Search department..."
                       onkeyup="filterDepartments()" />

                <button type="button" id="btnAddDepartment" class="btn-add" onclick="openAddDepartmentModal()">
                    + Add New Department
                </button>
            </div>
        </div>

        <div style="overflow-x: auto;">
            <table class="department-table">
                <thead>
                    <tr>
                        <th style="width: 10%;">ID</th>
                        <th style="width: 20%;">Code</th>
                        <th style="width: 35%;">Department Name</th>
                        <th style="width: 35%;">School</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var dept in Model.Departments)
                    {
                        var schoolName = Model.Schools.FirstOrDefault(s => s.Id == dept.SchoolId)?.Name ?? "N/A";

                        <tr class="department-row"
                            data-search="@($"{dept.Id} {dept.Code} {dept.Name} {schoolName}")">
                            <td>@dept.Id</td>
                            <td>
                                <span class="code-badge">@dept.Code</span>
                            </td>
                            <td>@dept.Name</td>
                            <td>@schoolName</td>
                        </tr>
                    }

                    <tr id="noDepartmentResults" class="no-results-row">
                        <td colspan="4">No matching departments found.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</div>

<script>
    function openAddDepartmentModal() {
        const modal = document.getElementById("addDepartmentModal");
        modal.style.display = "flex";
    }

    function closeAddDepartmentModal() {
        const modal = document.getElementById("addDepartmentModal");
        modal.style.display = "none";
    }

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            closeAddDepartmentModal();
        }
    });

    document.getElementById("addDepartmentModal").addEventListener("click", function (event) {
        if (event.target === this) {
            closeAddDepartmentModal();
        }
    });

    function filterDepartments() {
        const searchValue = document.getElementById("departmentSearch").value.toLowerCase().trim();
        const rows = document.querySelectorAll(".department-row");
        const noResultsRow = document.getElementById("noDepartmentResults");

        let visibleCount = 0;

        rows.forEach(row => {
            const searchableText = row.getAttribute("data-search").toLowerCase();

            if (searchableText.includes(searchValue)) {
                row.style.display = "";
                visibleCount++;
            } else {
                row.style.display = "none";
            }
        });

        if (noResultsRow) {
            noResultsRow.style.display = visibleCount === 0 ? "table-row" : "none";
        }
    }
</script>