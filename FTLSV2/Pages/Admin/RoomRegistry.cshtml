@page
@model FTLSV2.Pages.Admin.RoomRegistryModel
@{
    Layout = "_AdminSidebar";
    ViewData["Title"] = "Room Registry";
}

@section Styles {
    <link rel="stylesheet" href="~/css/RoomRegistry.css" />
}

<div class="page-container">
    <header class="page-header">
        <h1>Room Registry</h1>
        <button class="btn-primary" onclick="toggleAddRoomForm()">+ Add Room</button>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div id="success-alert" style="background-color: #d4edda; color: #155724; padding: 12px; margin-bottom: 20px; border-radius: 6px; border-left: 5px solid #28a745; font-weight: 500; transition: opacity 1s ease-out; opacity: 1;">
            ✓ @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div id="error-alert" style="background-color: #f8d7da; color: #721c24; padding: 12px; margin-bottom: 20px; border-radius: 6px; border-left: 5px solid #f5c6cb; font-weight: 500;">
            ✗ @TempData["ErrorMessage"]
        </div>
    }

    <div id="addRoomSection" class="card" style="display: none; margin-bottom: 20px; border-left: 5px solid #07362d;">
        <h3>Add New Room</h3>

        <form method="post" asp-page-handler="AddRoom" id="addRoomForm">
            <div style="display: flex; gap: 15px; margin-bottom: 15px;">
                <div style="flex: 1;">
                    <label>Room Name</label>
                    <input type="text"
                           asp-for="NewRoomName"
                           required
                           style="width: 100%; padding: 8px;"
                           placeholder="e.g. Room 101">
                </div>

                <div style="flex: 1;">
                    <label>Type</label>
                    <select asp-for="NewRoomType"
                            required
                            style="width: 100%; padding: 8px;">
                        <option value="">Select Type</option>
                        <option value="Lecture">Lecture</option>
                        <option value="Lab">Lab</option>
                    </select>
                </div>

                <div style="flex: 1;">
                    <label>Capacity</label>
                    <input type="number"
                           asp-for="NewRoomCapacity"
                           required
                           style="width: 100%; padding: 8px;"
                           value="30"
                           min="1">
                </div>
            </div>

            <button type="submit" class="btn-primary" id="saveRoomBtn">Save Room</button>
            <button type="button" class="btn-ghost" onclick="toggleAddRoomForm()" style="margin-left: 10px; padding: 10px; border: none; background: #eee; cursor: pointer;">
                Cancel
            </button>
        </form>
    </div>

    <div id="editRoomSection" class="card" style="display: none; margin-bottom: 20px; border-left: 5px solid #17a2b8;">
        <h3>Edit Room</h3>

        <form method="post" asp-page-handler="EditRoom">
            <input type="hidden" name="EditRoomId" id="editRoomId" />

            <div style="display: flex; gap: 15px; margin-bottom: 15px;">
                <div style="flex: 1;">
                    <label>Room Name</label>
                    <input type="text"
                           asp-for="EditRoomName"
                           id="editRoomName"
                           required
                           style="width: 100%; padding: 8px;">
                </div>

                <div style="flex: 1;">
                    <label>Type</label>
                    <select asp-for="EditRoomType"
                            id="editRoomType"
                            style="width: 100%; padding: 8px;">
                        <option value="Lecture">Lecture</option>
                        <option value="Lab">Lab</option>
                    </select>
                </div>

                <div style="flex: 1;">
                    <label>Capacity</label>
                    <input type="number"
                           asp-for="EditRoomCapacity"
                           id="editRoomCapacity"
                           required
                           min="1"
                           style="width: 100%; padding: 8px;">
                </div>
            </div>

            <button type="submit" class="btn-primary" style="background-color: #17a2b8;">Update Room</button>
            <button type="button" class="btn-ghost" onclick="hideEditForm()" style="margin-left: 10px; padding: 10px; border: none; background: #eee; cursor: pointer;">
                Cancel
            </button>
        </form>
    </div>

    <section class="card">
        <div class="room-toolbar" style="display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-bottom: 18px;">
            <h3 style="margin: 0;">Registered Rooms (@Model.Rooms.Count)</h3>

            <input type="text"
                   id="roomSearch"
                   class="room-search"
                   placeholder="Search room..."
                   onkeyup="filterRooms()"
                   style="width: 300px; padding: 10px 12px; border: 1px solid #dcdcdc; border-radius: 8px; font-size: 14px; outline: none;" />
        </div>

        <table class="room-table">
            <thead>
                <tr>
                    <th>Room Name</th>
                    <th>Type</th>
                    <th>Capacity</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Rooms.Any())
                {
                    @foreach (var room in Model.Rooms)
                    {
                        <tr class="room-row"
                            data-search="@($"{room.RoomId} {room.Name} {room.Type} {room.Capacity}")">
                            <td>@room.Name</td>
                            <td>@room.Type</td>
                            <td>@room.Capacity</td>
                            <td>
                                <div style="display: flex; gap: 5px;">
                                    <button class="btn-edit"
                                            onclick='showEditForm(@room.RoomId, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(room.Name)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(room.Type)), @room.Capacity)'>
                                        Edit
                                    </button>

                                    <form method="post"
                                          asp-page-handler="DeleteRoom"
                                          style="margin: 0;"
                                          onsubmit="return confirm('Are you sure you want to delete @room.Name?');">
                                        <input type="hidden" name="roomId" value="@room.RoomId" />
                                        <button type="submit" class="btn-delete" style="color: red; border-color: red;">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }

                    <tr id="noRoomResults" style="display: none; text-align: center; color: #888; font-style: italic;">
                        <td colspan="4" style="padding: 20px;">No matching rooms found.</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 20px; color: #777;">
                            No rooms registered.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>

<script>
    function toggleAddRoomForm() {
        var form = document.getElementById("addRoomSection");
        document.getElementById("editRoomSection").style.display = "none";

        if (form.style.display === "none" || form.style.display === "") {
            form.style.display = "block";
        } else {
            form.style.display = "none";
        }
    }

    function showEditForm(id, name, type, capacity) {
        document.getElementById("addRoomSection").style.display = "none";

        document.getElementById("editRoomId").value = id;
        document.getElementById("editRoomName").value = name;
        document.getElementById("editRoomType").value = type;
        document.getElementById("editRoomCapacity").value = capacity;

        document.getElementById("editRoomSection").style.display = "block";
    }

    function hideEditForm() {
        document.getElementById("editRoomSection").style.display = "none";
    }

    function filterRooms() {
        const searchInput = document.getElementById("roomSearch");
        const rows = document.querySelectorAll(".room-row");
        const noResultsRow = document.getElementById("noRoomResults");

        if (!searchInput) {
            return;
        }

        const searchValue = searchInput.value.toLowerCase().trim();
        let visibleCount = 0;

        rows.forEach(row => {
            const searchableText = row.getAttribute("data-search").toLowerCase();

            if (searchableText.includes(searchValue)) {
                row.style.display = "";
                visibleCount++;
            } else {
                row.style.display = "none";
            }
        });

        if (noResultsRow) {
            noResultsRow.style.display = visibleCount === 0 ? "table-row" : "none";
        }
    }

    window.onload = function () {
        var alertBox = document.getElementById("success-alert");

        if (alertBox) {
            setTimeout(function () {
                alertBox.style.opacity = "0";

                setTimeout(function () {
                    alertBox.style.display = "none";
                }, 1000);
            }, 3000);
        }
    };
</script>