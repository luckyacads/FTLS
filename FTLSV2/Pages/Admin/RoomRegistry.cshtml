@page
@model FTLSV2.Pages.Admin.RoomRegistryModel
@{
    Layout = "_AdminSidebar";
    ViewData["Title"] = "Room Registry";
}

@section Styles {
    <link rel="stylesheet" href="~/css/RoomRegistry.css" />
}

<style>
    body {
        background: #f5f7fa;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .page-container {
        padding: 20px 40px;
        width: 100%;
        max-width: 100% !important;
        margin: 0 !important;
        box-sizing: border-box;
    }

    .page-header {
        margin-bottom: 18px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 26px;
            font-weight: 700;
            color: #07362d;
        }

        .page-header p {
            margin-top: 6px;
            font-size: 14px;
            color: #0f6e56;
            font-weight: 600;
        }

    .card {
        background: white;
        border-radius: 12px;
        padding: 18px 20px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.06);
        margin-bottom: 18px;
    }

    .form-title {
        margin-top: 0;
        margin-bottom: 16px;
        font-size: 18px;
        color: #07362d;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 14px;
        margin-bottom: 14px;
    }

    .form-group label {
        display: block;
        margin-bottom: 6px;
        font-size: 13px;
        font-weight: 600;
        color: #555;
    }

    .input {
        width: 100%;
        padding: 9px 11px;
        border-radius: 7px;
        border: 1px solid #dcdcdc;
        box-sizing: border-box;
        font-size: 14px;
    }

        .input:focus {
            border-color: #07362d;
            outline: none;
            box-shadow: 0 0 0 2px rgba(7,54,45,0.12);
        }

    .btn-primary,
    .btn-add {
        background: #07362d;
        color: white;
        border: none;
        padding: 9px 14px;
        border-radius: 7px;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease-in-out;
        white-space: nowrap;
    }

        .btn-primary:hover,
        .btn-add:hover {
            background: #0a4d40;
            transform: translateY(-1px);
        }

    .btn-ghost {
        padding: 9px 14px;
        border: none;
        background: #eeeeee;
        color: #333;
        border-radius: 7px;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease-in-out;
    }

        .btn-ghost:hover {
            background: #dddddd;
            transform: translateY(-1px);
        }

    .btn-edit {
        padding: 6px 10px;
        border: 1px solid #dcdcdc;
        background: white;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
    }

        .btn-edit:hover {
            background: #f3f6f5;
            border-color: #07362d;
        }

    .btn-delete {
        padding: 6px 10px;
        border: 1px solid red;
        background: white;
        color: red;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
    }

        .btn-delete:hover {
            background: #fff1f1;
        }

    .alert-success {
        background-color: #d4edda;
        color: #155724;
        padding: 12px;
        margin-bottom: 16px;
        border-radius: 8px;
        border-left: 6px solid #28a745;
        font-weight: 500;
        transition: opacity 1s ease-out;
        opacity: 1;
    }

    .alert-error {
        background-color: #f8d7da;
        color: #721c24;
        padding: 12px;
        margin-bottom: 16px;
        border-radius: 8px;
        border-left: 6px solid #f5c6cb;
        font-weight: 500;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .room-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 14px;
    }

        .room-toolbar h3 {
            margin: 0;
            font-size: 18px;
            color: #07362d;
        }

    .room-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .room-search {
        width: 300px;
        padding: 9px 11px;
        border: 1px solid #dcdcdc;
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        transition: all 0.2s ease-in-out;
    }

        .room-search:focus {
            border-color: #07362d;
            box-shadow: 0 0 0 2px rgba(7,54,45,0.12);
        }

    .room-table-wrapper {
        overflow-x: auto;
        overflow-y: auto;
        max-height: calc(100vh - 285px);
        border-radius: 8px;
    }

    .room-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 760px;
    }

        .room-table thead {
            background: #f8f9fb;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        .room-table th {
            font-size: 11px;
            text-transform: uppercase;
            color: #888;
            padding: 10px 12px;
            text-align: left;
            border-bottom: 1px solid #eeeeee;
            letter-spacing: 0.3px;
        }

        .room-table td {
            padding: 10px 12px;
            border-bottom: 1px solid #eeeeee;
            font-size: 14px;
            color: #111827;
            vertical-align: middle;
        }

        .room-table tr:hover {
            background: #f6f9fc;
        }

    .room-type-badge {
        display: inline-block;
        background: #e1f5ee;
        color: #0f6e56;
        padding: 4px 8px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 700;
    }

    .room-row-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .no-results-row {
        display: none;
        text-align: center;
        color: #888;
        font-style: italic;
    }

    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.4);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(2px);
    }

    .add-modal-card {
        width: 760px;
        max-width: calc(100% - 40px);
        position: relative;
        padding: 28px 30px;
        border-radius: 16px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        border-left: 6px solid #07362d;
        margin-bottom: 0;
        animation: modalFadeIn 0.18s ease-out;
    }

    .edit-modal-card {
        width: 760px;
        max-width: calc(100% - 40px);
        position: relative;
        padding: 28px 30px;
        border-radius: 16px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        border-left: 6px solid #17a2b8;
        margin-bottom: 0;
        animation: modalFadeIn 0.18s ease-out;
    }

    .modal-header,
    .edit-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 18px;
    }

        .modal-header h3,
        .edit-modal-header h3 {
            margin: 0;
            color: #111827;
            font-size: 22px;
            font-weight: 700;
        }

    .modal-close-x {
        border: none;
        background: transparent;
        color: #6b7280;
        cursor: pointer;
        font-size: 24px;
        line-height: 1;
        padding: 0;
    }

        .modal-close-x:hover {
            color: #111827;
        }

    @@keyframes modalFadeIn {
        from {
            opacity: 0;
            transform: translateY(-8px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@media (max-width: 900px) {
        .page-container {
            padding: 18px 20px;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .room-toolbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .room-actions {
            width: 100%;
        }

        .room-search {
            width: 100%;
        }

        .add-modal-card,
        .edit-modal-card {
            width: calc(100% - 30px);
            padding: 24px 20px;
        }
    }
</style>

<div class="page-container">
    <div class="page-header">
        <h1>Room Registry</h1>
        <p id="roomFilterSummary" style="display: none;"></p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div id="success-alert" class="alert-success">
            ✓ @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div id="error-alert" class="alert-error">
            ✗ @TempData["ErrorMessage"]
        </div>
    }

    <section class="card">
        <div class="room-toolbar">
            <h3>Registered Rooms (@Model.Rooms.Count)</h3>

            <div class="room-actions">
                <input type="text"
                       id="roomSearch"
                       class="room-search"
                       placeholder="Search room..."
                       oninput="filterRooms()" />

                <button type="button"
                        id="btnAddRoom"
                        class="btn-add"
                        onclick="openAddRoomModal()">
                    + Add New Room
                </button>
            </div>
        </div>

        <div class="room-table-wrapper">
            <table class="room-table">
                <thead>
                    <tr>
                        <th style="width: 35%;">Room Name</th>
                        <th style="width: 25%;">Type</th>
                        <th style="width: 20%;">Capacity</th>
                        <th style="width: 20%;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Rooms.Any())
                    {
                        @foreach (var room in Model.Rooms)
                        {
                            <tr class="room-row"
                                data-search="@($"{room.RoomId} {room.Name} {room.Type} {room.Capacity}")"
                                data-type="@((room.Type ?? "").ToLower())">
                                <td>@room.Name</td>
                                <td>
                                    <span class="room-type-badge">@room.Type</span>
                                </td>
                                <td>@room.Capacity</td>
                                <td>
                                    <div class="room-row-actions">
                                        <button type="button"
                                                class="btn-edit"
                                                onclick='openEditModal(@room.RoomId, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(room.Name)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(room.Type)), @room.Capacity)'>
                                            Edit
                                        </button>

                                        <button type="button"
                                                class="btn-delete"
                                                onclick='openDeleteModal(@room.RoomId, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(room.Name)))'>
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }

                        <tr id="noRoomResults" class="no-results-row">
                            <td colspan="4" style="padding: 18px;">
                                No matching rooms found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="text-align: center; padding: 18px; color: #777;">
                                No rooms registered.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<!-- ADD ROOM MODAL -->
<div id="addRoomModal" class="modal-overlay">
    <div class="card add-modal-card">
        <div class="modal-header">
            <h3>Add New Room</h3>
            <button type="button" class="modal-close-x" onclick="closeModal('addRoomModal')">
                &times;
            </button>
        </div>

        <form method="post" asp-page-handler="AddRoom" id="addRoomForm">
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="NewRoomName">Room Name</label>
                    <input asp-for="NewRoomName"
                           class="input"
                           required
                           placeholder="Example: Room 101" />
                </div>

                <div class="form-group">
                    <label asp-for="NewRoomType">Type</label>
                    <select asp-for="NewRoomType" class="input" required>
                        <option value="">Select Type</option>
                        <option value="Lecture">Lecture</option>
                        <option value="Lab">Lab</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="NewRoomCapacity">Capacity</label>
                    <input asp-for="NewRoomCapacity"
                           type="number"
                           class="input"
                           required
                           value="30"
                           min="1" />
                </div>
            </div>

            <div class="form-actions" style="margin-top: 16px;">
                <button type="button" class="btn-ghost" onclick="closeModal('addRoomModal')">
                    Cancel
                </button>

                <button type="submit" class="btn-primary" id="saveRoomBtn">
                    Save Room
                </button>
            </div>
        </form>
    </div>
</div>

<!-- EDIT ROOM MODAL -->
<div id="editRoomModal" class="modal-overlay">
    <div class="card edit-modal-card">
        <div class="edit-modal-header">
            <h3>Edit Room</h3>
            <button type="button" class="modal-close-x" onclick="closeModal('editRoomModal')">
                &times;
            </button>
        </div>

        <form method="post" asp-page-handler="EditRoom">
            <input type="hidden" name="EditRoomId" id="editRoomId" />

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="EditRoomName">Room Name</label>
                    <input asp-for="EditRoomName"
                           id="editRoomName"
                           class="input"
                           required />
                </div>

                <div class="form-group">
                    <label asp-for="EditRoomType">Type</label>
                    <select asp-for="EditRoomType" id="editRoomType" class="input">
                        <option value="Lecture">Lecture</option>
                        <option value="Lab">Lab</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="EditRoomCapacity">Capacity</label>
                    <input asp-for="EditRoomCapacity"
                           type="number"
                           id="editRoomCapacity"
                           class="input"
                           required
                           min="1" />
                </div>
            </div>

            <div class="form-actions" style="margin-top: 16px;">
                <button type="button" class="btn-ghost" onclick="closeModal('editRoomModal')">
                    Cancel
                </button>

                <button type="submit" class="btn-primary" style="background-color: #17a2b8;">
                    Update Room
                </button>
            </div>
        </form>
    </div>
</div>

<!-- HIDDEN DELETE FORM -->
<form method="post" asp-page-handler="DeleteRoom" id="deleteRoomForm" style="display:none;">
    <input type="hidden" name="roomId" id="deleteRoomId" />
</form>

<!-- DELETE CONFIRMATION MODAL -->
<div id="deleteConfirmModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.4); z-index:1000; align-items:center; justify-content:center; backdrop-filter: blur(2px);">
    <div class="card" style="width: 400px; position: relative; text-align: center; padding: 40px 30px; border-radius: 16px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); margin-bottom: 0;">

        <h3 style="margin-top:0; color:#111827; font-size: 24px; font-weight: 700; margin-bottom: 12px;">Are you sure?</h3>

        <p id="deleteModalMessage" style="font-size:14px; color:#4b5563; margin-bottom:30px; line-height: 1.5;"></p>

        <div style="display: flex; gap: 12px; justify-content: center;">
            <button type="button"
                    style="background:#ffffff; color:#374151; border: 1px solid #d1d5db; padding: 10px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; width: 130px; transition: all 0.2s;"
                    onclick="closeModal('deleteConfirmModal')">
                Cancel
            </button>

            <button type="button"
                    id="confirmDeleteBtn"
                    style="background:#f43f5e; color:white; border: none; padding: 10px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; width: 130px; transition: background 0.2s;"
                    onclick="submitDeleteRoom()">
                Delete
            </button>
        </div>
    </div>
</div>

<script>
    function openAddRoomModal() {
        closeModal("editRoomModal");
        closeModal("deleteConfirmModal");
        openModal("addRoomModal");
    }

    function openEditModal(id, name, type, capacity) {
        closeModal("addRoomModal");

        document.getElementById("editRoomId").value = id;
        document.getElementById("editRoomName").value = name;
        document.getElementById("editRoomType").value = type;
        document.getElementById("editRoomCapacity").value = capacity;

        openModal("editRoomModal");
    }

    function openDeleteModal(roomId, roomName) {
        closeModal("addRoomModal");
        closeModal("editRoomModal");

        document.getElementById("deleteRoomId").value = roomId;

        const message = document.getElementById("deleteModalMessage");
        message.innerText = `This will permanently delete "${roomName}" from the room registry. This action cannot be undone.`;

        openModal("deleteConfirmModal");
    }

    function submitDeleteRoom() {
        const form = document.getElementById("deleteRoomForm");

        if (form) {
            form.submit();
        }
    }

    function openModal(modalId) {
        const modal = document.getElementById(modalId);

        if (modal) {
            modal.style.display = "flex";
        }
    }

    function closeModal(modalId) {
        const modal = document.getElementById(modalId);

        if (modal) {
            modal.style.display = "none";
        }
    }

    function filterRooms() {
        const searchInput = document.getElementById("roomSearch");
        const rows = document.querySelectorAll(".room-row");
        const noResultsRow = document.getElementById("noRoomResults");
        const summary = document.getElementById("roomFilterSummary");

        if (!searchInput) {
            return;
        }

        const originalSearchValue = searchInput.value.trim();
        const searchValue = originalSearchValue.toLowerCase();

        let visibleCount = 0;

        rows.forEach(row => {
            const searchableText = (row.getAttribute("data-search") || "").toLowerCase();
            const roomType = (row.getAttribute("data-type") || "").toLowerCase();

            let isMatch = false;

            if (searchValue === "") {
                isMatch = true;
            }
            else if (searchValue === "lab") {
                isMatch = roomType === "lab";
            }
            else if (searchValue === "lecture") {
                isMatch = roomType === "lecture";
            }
            else if (searchValue === "laboratory") {
                isMatch = roomType === "lab";
            }
            else {
                isMatch = searchableText.includes(searchValue);
            }

            if (isMatch) {
                row.style.display = "";
                visibleCount++;
            } else {
                row.style.display = "none";
            }
        });

        if (noResultsRow) {
            noResultsRow.style.display = visibleCount === 0 ? "table-row" : "none";
        }

        if (summary) {
            if (searchValue === "") {
                summary.style.display = "none";
                summary.innerText = "";
            }
            else if (searchValue === "lab" || searchValue === "laboratory") {
                summary.style.display = "block";
                summary.innerText = `Number of rooms with 'Lab': ${visibleCount}`;
            }
            else if (searchValue === "lecture") {
                summary.style.display = "block";
                summary.innerText = `Number of rooms with 'Lecture': ${visibleCount}`;
            }
            else {
                summary.style.display = "block";
                summary.innerText = `Matching rooms for '${originalSearchValue}': ${visibleCount}`;
            }
        }
    }

    function closeModalOnOverlayClick(modalId) {
        const modal = document.getElementById(modalId);

        if (!modal) {
            return;
        }

        modal.addEventListener("click", function (event) {
            if (event.target === modal) {
                closeModal(modalId);
            }
        });
    }

    window.onload = function () {
        const alertBox = document.getElementById("success-alert");

        if (alertBox) {
            setTimeout(function () {
                alertBox.style.opacity = "0";

                setTimeout(function () {
                    alertBox.style.display = "none";
                }, 1000);
            }, 3000);
        }

        closeModalOnOverlayClick("addRoomModal");
        closeModalOnOverlayClick("editRoomModal");
        closeModalOnOverlayClick("deleteConfirmModal");
    };

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            closeModal("addRoomModal");
            closeModal("editRoomModal");
            closeModal("deleteConfirmModal");
        }
    });
</script>