@page
@model FTLSV2.Pages.RegisterPageModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Register - FTLS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <style>
            body {
                margin: 0;
                min-height: 100vh;
                font-family: Arial, sans-serif;
                background: linear-gradient(135deg, #0f5132, #198754);
                display: flex;
                justify-content: center;
                align-items: center;
            }

            .register-card {
                width: 480px;
                background: #ffffff;
                padding: 35px;
                border-radius: 18px;
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
            }

            .register-title {
                text-align: center;
                color: #123524;
                margin-bottom: 8px;
                font-size: 28px;
                font-weight: 700;
            }

            .register-subtitle {
                text-align: center;
                color: #6b7280;
                margin-bottom: 25px;
                font-size: 14px;
            }

            .form-group {
                margin-bottom: 14px;
            }

            .form-label {
                display: block;
                margin-bottom: 6px;
                color: #123524;
                font-weight: 600;
                font-size: 14px;
            }

            .form-input,
            .form-select {
                width: 100%;
                padding: 11px 12px;
                border: 1px solid #d1d5db;
                border-radius: 10px;
                font-size: 14px;
                box-sizing: border-box;
            }

                .form-input:focus,
                .form-select:focus {
                    outline: none;
                    border-color: #198754;
                    box-shadow: 0 0 0 3px rgba(25, 135, 84, 0.15);
                }

            .register-button-group {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 14px;
                margin-top: 22px;
            }

            .register-btn {
                width: 170px;
                padding: 12px 24px;
                border-radius: 10px;
                font-weight: 600;
                font-size: 15px;
                cursor: pointer;
                transition: all 0.2s ease-in-out;
                text-align: center;
                text-decoration: none;
                display: inline-flex;
                justify-content: center;
                align-items: center;
                box-sizing: border-box;
            }

            .register-btn-primary {
                background-color: #198754;
                color: white;
                border: 2px solid #198754;
            }

                .register-btn-primary:hover {
                    background-color: #ffc107;
                    color: #123524;
                    border-color: #ffc107;
                    transform: translateY(-1px);
                }

            .register-btn-secondary {
                background-color: white;
                color: #198754;
                border: 2px solid #198754;
            }

                .register-btn-secondary:hover {
                    background-color: #198754;
                    color: white;
                    transform: translateY(-1px);
                }

            .validation-message {
                color: #dc3545;
                font-size: 13px;
                margin-top: 4px;
                display: block;
            }

            .alert-error {
                background: #f8d7da;
                color: #842029;
                border: 1px solid #f5c2c7;
                padding: 10px;
                border-radius: 10px;
                margin-bottom: 15px;
                font-size: 14px;
            }

            .alert-success {
                background: #d1e7dd;
                color: #0f5132;
                border: 1px solid #badbcc;
                padding: 10px;
                border-radius: 10px;
                margin-bottom: 15px;
                font-size: 14px;
            }
    </style>
</head>

<body>
    <div class="register-card">
        <h1 class="register-title">Create Account</h1>
        <p class="register-subtitle">Faculty Task Load Scheduler Registration</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert-error">@Model.ErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert-success">@Model.SuccessMessage</div>
        }

        <form method="post">
            <div class="form-group">
                <label class="form-label" asp-for="FacultyId">Faculty ID</label>
                <input class="form-input" asp-for="FacultyId" placeholder="Enter 8-character Faculty ID" />
                <span class="validation-message" asp-validation-for="FacultyId"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="FirstName">First Name</label>
                <input class="form-input" asp-for="FirstName" placeholder="Enter first name" />
                <span class="validation-message" asp-validation-for="FirstName"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="LastName">Last Name</label>
                <input class="form-input" asp-for="LastName" placeholder="Enter last name" />
                <span class="validation-message" asp-validation-for="LastName"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Email">Email</label>
                <input class="form-input" asp-for="Email" placeholder="Enter email address" />
                <span class="validation-message" asp-validation-for="Email"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Role">Register As</label>
                <select class="form-select" asp-for="Role">
                    <option value="">-- Select Role --</option>
                    <option value="Teacher">Teacher</option>
                    <option value="Chairman">Chairman</option>
                </select>
                <span class="validation-message" asp-validation-for="Role"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Password">Password</label>
                <input class="form-input" asp-for="Password" type="password" placeholder="Enter password" />
                <span class="validation-message" asp-validation-for="Password"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="ConfirmPassword">Confirm Password</label>
                <input class="form-input" asp-for="ConfirmPassword" type="password" placeholder="Confirm password" />
                <span class="validation-message" asp-validation-for="ConfirmPassword"></span>
            </div>

            <div class="register-button-group">
                <button type="submit" class="register-btn register-btn-primary">
                    Register
                </button>

                <a asp-page="/LoginPage" class="register-btn register-btn-secondary">
                    Back to Login
                </a>
            </div>
        </form>
    </div>
</body>
</html>