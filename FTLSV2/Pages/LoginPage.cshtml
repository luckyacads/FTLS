@page
@model FTLSV2.Pages.LoginPageModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Faculty Scheduler</title>

    <style>
        :root {
            --primary: #07362d;
            --secondary: #184a40;
            --accent-hover: #0b5c4d;
            --danger: #e74c3c;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
            height: 100vh;
            /* FULL BACKGROUND IMAGE */
            background: url('/images/FTLS_CoverWebsite.png') no-repeat center center fixed;
            background-size: cover;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            background: white;
            padding: 50px;
            border-radius: 10px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.5);
            width: 100%;
            max-width: 600px;
            text-align: center;
        }

        .login-logo {
            width: 220px;
            height: 220px;
            object-fit: contain;
            margin-bottom: 20px;
            display: block;
            margin-left: auto;
            margin-right: auto;
        }

        h2 {
            color: var(--primary);
            margin-bottom: 10px;
            font-size: 1.8rem;
            font-weight: 800;
        }

        p {
            color: var(--secondary);
            margin-bottom: 35px;
            font-size: 1rem;
        }

        .form-group {
            margin-bottom: 20px;
            text-align: left;
        }

        label {
            display: block;
            font-weight: 600;
            color: var(--secondary);
            margin-bottom: 6px;
            font-size: 1rem;
        }

        input {
            width: 100%;
            padding: 14px;
            border: 1px solid #ddd;
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 1rem;
            background-color: #f9f9f9;
            transition: 0.3s ease;
        }

            input:focus {
                outline: none;
                border-color: var(--primary);
                background-color: #fff;
                box-shadow: 0 0 0 3px rgba(7, 54, 45, 0.15);
            }

        .btn-primary {
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            width: 100%;
            font-size: 1rem;
            transition: 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 10px;
        }

            .btn-primary:hover {
                background-color: var(--accent-hover);
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(0,0,0,0.3);
            }

        .alert-error {
            background-color: #ffeaea;
            color: var(--danger);
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 20px;
            border-left: 5px solid var(--danger);
            font-size: 0.95rem;
            text-align: left;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <img src="~/images/FTLS_logo.png" alt="FTLS Logo" class="login-logo" />

        <h2>FACULTY TEACHING LOAD SCHEDULER (FTLS)</h2>
        <p>University of San Jose-Recoletos</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert-error">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div class="form-group">
                <label>Faculty ID</label>
                <input type="text" asp-for="Username" placeholder="Enter your 8-digit ID" required minlength="8" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" asp-for="Password" placeholder="Enter your password" required />
            </div>

            <button type="submit" class="btn-primary">Sign In</button>
        </form>
    </div>

</body>
</html>