@page
@model FTLSV2.Pages.AccountSettingsModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Settings - FTLS</title>
    <link rel="stylesheet" href="../CSS/AccountSettings.css">
</head>
<body>

    <div class="teacher-container">
        <aside class="sidebar">
            <h2>Teacher Portal</h2>
            <nav>
                <a href="/TeacherPage">My Schedule</a>
                <a href="/CurriculumView">Curriculum View</a>
                <a href="/AccountSettings" class="active">Account Settings</a>
                <a href="/LoginPage" class="logout">Logout</a>
            </nav>
        </aside>

        <main class="main-content">
            <header>
                <h1>Account Settings</h1>
            </header>

            <div class="teacher-grid">
                <section class="card full-width">
                    <h3>Profile</h3>
                    <div class="profile-row">
                        <div class="avatar">E</div>
                        <div>
                            <p class="name">Engr. Harley</p>
                            <p class="role">Faculty</p>
                        </div>
                    </div>
                </section>

                <section class="card">
                    <h3>Change Password</h3>
                    <form method="post" asp-page-handler="ChangePassword">
                        <div class="form-group">
                            <label>Current Password</label>
                            <input type="password" name="currentPassword" required />
                        </div>
                        <div class="form-group">
                            <label>New Password</label>
                            <input type="password" name="newPassword" required />
                        </div>
                        <div style="margin-top:10px;">
                            <button type="submit" class="btn-primary">Update Password</button>
                        </div>
                    </form>
                </section>
            </div>
        </main>
    </div>

</body>
</html>