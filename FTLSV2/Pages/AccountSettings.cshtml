@page
@model FTLSV2.Pages.AccountSettingsModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Settings - FTLS</title>
    <link rel="stylesheet" href="../CSS/AccountSettings.css">
</head>
<body>

    <div class="teacher-container">
        <aside class="sidebar">
            <h2>Teacher Portal</h2>
            <nav>
                <a href="/TeacherPage">My Schedule</a>
                <a href="/CurriculumView">Curriculum View</a>
                <a href="/AccountSettings" class="active">Account Settings</a>
                <a href="/LoginPage" class="logout">Logout</a>
            </nav>
        </aside>

        <main class="main-content">
            <header>
                <h1>Account Settings</h1>
            </header>

            <div class="teacher-grid">
                <section class="card full-width">
                    <h3>Profile</h3>
                    <div class="profile-row">
                        <div class="avatar">@(Model.LoggedInUser.FirstName.Substring(0, 1))</div>
                        <div>
                            <p class="name">@Model.LoggedInUser.FirstName @Model.LoggedInUser.LastName</p>
                            <p class="role">@Model.LoggedInUser.Role</p>
                        </div>
                    </div>
                </section>

                <section class="card">
                    <h3>Change Password</h3>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div style="background: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 15px; border-radius: 4px;">@Model.ErrorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div style="background: #d4edda; color: #155724; padding: 10px; margin-bottom: 15px; border-radius: 4px;">@Model.SuccessMessage</div>
                    }

                    <form method="post" asp-page-handler="ChangePassword">
                        <div class="form-group">
                            <label>Current Password</label>
                            <input type="password" asp-for="CurrentPassword" required />
                        </div>
                        <div class="form-group">
                            <label>New Password</label>
                            <input type="password" asp-for="NewPassword" required />
                        </div>
                        <div style="margin-top:10px;">
                            <button type="submit" class="btn-primary">Update Password</button>
                        </div>
                    </form>
                </section>
            </div>
        </main>
    </div>

</body>
</html>